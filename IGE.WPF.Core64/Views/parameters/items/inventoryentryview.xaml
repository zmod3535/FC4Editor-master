<UserControl
	x:Class="IGE.Views.InventoryEntryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="100"
	Height="135"
	BorderThickness="1"
	BorderBrush="#FF808080" xmlns:views="clr-namespace:IGE.Views"
	ToolTip="{Binding Text}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Image
				Stretch="None"
				Source="{Binding Image}" />
			<TextBlock
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Background="#FF000000"
				Foreground="#FFFFFFFF"
				Padding="3,0"
				Text="{Binding Height}"
				Visibility="{Binding HeightVisible}" />
		</Grid>
		<TextBlock
			Grid.Row="1"
			TextWrapping="WrapWithOverflow"
			Text="{Binding Text}" />
	</Grid>
</UserControl>
