<UserControl
	x:Class="IGE.Views.ParamEnumButtonItemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:views="clr-namespace:IGE.Views"
	IsEnabled="{Binding Enabled}">
	<ToggleButton
		Margin="2"
		ToolTip="{Binding DisplayName}"
		Content="{Binding DisplayName}"
		IsChecked="{Binding IsActive}"
		PreviewMouseLeftButtonDown="Button_OnPreviewMouseLeftButtonDown" />
</UserControl>
