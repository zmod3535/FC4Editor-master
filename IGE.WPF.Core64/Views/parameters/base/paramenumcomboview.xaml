<UserControl
	x:Class="IGE.Views.ParamEnumComboView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:b="clr-namespace:IGE.ViewModels.Behaviours" xmlns:views="clr-namespace:IGE.Views"
	IsEnabled="{Binding Enabled}"
	Visibility="{Binding Visible}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter
				x:Key="BoolToVis" />
			<b:BooleanToVisibilityNoCollapseConverter
				x:Key="BoolToVisNoCollapse" />
			<b:ComboBoxItemTemplateChooser
				x:Key="ComboBoxItemTemplateChooser" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<StackPanel>
		<Label
			Content="{Binding DisplayName}" />
		<ComboBox
			HorizontalContentAlignment="Stretch"
			ItemTemplateSelector="{StaticResource ComboBoxItemTemplateChooser}"
			ItemsSource="{Binding Values}"
			SelectedIndex="{Binding SelectedIndex}">
			<b:ComboBoxItemTemplateChooser.SelectedTemplate>
				<DataTemplate>
					<TextBlock
						Height="Auto"
						Visibility="{Binding EntryVisible, Converter={StaticResource BoolToVisNoCollapse}}"
						Text="{Binding DisplayName}" />
				</DataTemplate>
			</b:ComboBoxItemTemplateChooser.SelectedTemplate>
			<b:ComboBoxItemTemplateChooser.DropDownTemplate>
				<DataTemplate>
					<TextBlock
						Height="Auto"
						Visibility="{Binding EntryVisible, Converter={StaticResource BoolToVis}}"
						Text="{Binding DisplayName}" />
				</DataTemplate>
			</b:ComboBoxItemTemplateChooser.DropDownTemplate>
		</ComboBox>
	</StackPanel>
</UserControl>
