<UserControl
	x:Class="IGE.Views.ParamEnumListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:params="clr-namespace:IGE.Parameters" xmlns:views="clr-namespace:IGE.Views" xmlns:b="clr-namespace:IGE.ViewModels.Behaviours"
	IsEnabled="{Binding Enabled}"
	Visibility="{Binding Visible}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<DataTemplate
				DataType="{x:Type params:ParamEnumListItem}"
				x:Key="{DataTemplateKey {x:Type params:ParamEnumListItem}}">
				<views:ParamEnumListItemView />
			</DataTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<StackPanel>
		<Label
			Content="{Binding DisplayName}" />
		<ListBox
			HorizontalContentAlignment="Stretch"
			ItemsSource="{Binding Values}"
			SelectedIndex="{Binding SelectedIndex}"
			MouseDoubleClick="ListBox_OnDoubleClick" />
	</StackPanel>
</UserControl>
