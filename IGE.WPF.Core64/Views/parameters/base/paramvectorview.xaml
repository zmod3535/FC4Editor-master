<UserControl
	x:Class="IGE.Views.ParamVectorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:b="clr-namespace:IGE.ViewModels.Behaviours" xmlns:views="clr-namespace:IGE.Views"
	IsEnabled="{Binding Enabled}"
	Visibility="{Binding Visible}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="20" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="20" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="20" />
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="5" />
		</Grid.ColumnDefinitions>
		<Label
			Grid.ColumnSpan="7"
			Grid.Row="0"
			Content="{Binding DisplayName}" />
		<Label
			Grid.Column="0"
			Grid.Row="1"
			Content="X:" />
		<TextBox
			b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="Text"
			Grid.Column="1"
			Grid.Row="1"
			Margin="0,0,0,10"
			Text="{Binding X}" />
		<Label
			Grid.Column="2"
			Grid.Row="1"
			Content="Y:" />
		<TextBox
			b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="Text"
			Grid.Column="3"
			Grid.Row="1"
			Margin="0,0,0,10"
			Text="{Binding Y}" />
		<Label
			Grid.Column="4"
			Grid.Row="1"
			Content="Z:" />
		<TextBox
			b:InputBindingsManager.UpdatePropertySourceWhenEnterPressed="Text"
			Grid.Column="5"
			Grid.Row="1"
			Margin="0,0,0,10"
			Text="{Binding Z}" />
	</Grid>
</UserControl>
