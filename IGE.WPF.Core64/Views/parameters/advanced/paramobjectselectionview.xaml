<UserControl
	x:Class="IGE.Views.ParamObjectSelectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:b="clr-namespace:IGE.ViewModels.Behaviours" xmlns:views="clr-namespace:IGE.Views"
	IsEnabled="{Binding Enabled}"
	Visibility="{Binding Visible}">
	<DockPanel>
		<Label
			DockPanel.Dock="Top"
			Content="{Binding DisplayName}" />
		<ListView
			Height="175"
			SelectionMode="Single"
			ItemsSource="{Binding Items}"
			SelectedItem="{Binding SelectedObject}">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						TargetType="{x:Type ListViewItem}"
						x:Key="{x:Type ListViewItem}">
						<Style.Resources>
							<ResourceDictionary>
								<SolidColorBrush
									Color="Teal"
									Opacity=".4"
									x:Key="{x:Static SystemColors.ControlBrushKey}" />
							</ResourceDictionary>
						</Style.Resources>
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
			<ItemsControl.ItemContainerStyle>
				<Style
					TargetType="{x:Type ListViewItem}">
					<Setter
						Property="b:MouseDoubleClickBehaviour.Command"
						Value="{Binding OnDoubleClick}" />
					<Setter
						Property="b:MouseDoubleClickBehaviour.CommandParameter"
						Value="{Binding}" />
				</Style>
			</ItemsControl.ItemContainerStyle>
		</ListView>
	</DockPanel>
</UserControl>
