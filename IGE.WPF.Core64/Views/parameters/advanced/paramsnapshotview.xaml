<UserControl
	x:Class="IGE.Views.ParamSnapshotView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlp="clr-namespace:IGE.Helpers" xmlns:views="clr-namespace:IGE.Views"
	IsEnabled="{Binding Enabled}"
	Visibility="{Binding Visible}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Row="0"
			Grid.ColumnSpan="2"
			Text="{hlp:Localize PARAM_SNAPSHOT}" />
		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			BorderThickness="1"
			BorderBrush="#FF000000"
			Background="#FFF8F8FF"
			Width="211"
			Height="116">
			<Image
				Stretch="Fill"
				Source="{Binding SnapshotImage}" />
		</Border>
		<Button
			Grid.Row="2"
			Grid.Column="0"
			Margin="2"
			Content="{hlp:Localize PARAM_SNAPSHOT_SET}"
			Command="{Binding CommandSet}" />
		<Button
			Grid.Row="2"
			Grid.Column="1"
			Margin="2"
			Content="{hlp:Localize PARAM_SNAPSHOT_GOTO}"
			Command="{Binding CommandGoto}" />
	</Grid>
</UserControl>
