<UserControl
	x:Class="IGE.Views.ParamInventoryObjectView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hlp="clr-namespace:IGE.Helpers" xmlns:params="clr-namespace:IGE.Parameters" xmlns:views="clr-namespace:IGE.Views"
	IsEnabled="{Binding Enabled}"
	Visibility="{Binding Visible}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<DataTemplate
				DataType="{x:Type params:ObjectSelectorViewModel}"
				x:Key="{DataTemplateKey {x:Type params:ObjectSelectorViewModel}}">
				<views:ObjectSelectorView />
			</DataTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="450"
				MinHeight="450" />
			<RowDefinition
				Height="5" />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Label
			Grid.Column="0"
			Grid.Row="2"
			Content="{hlp:LocalizeCommon PARAM_OBJECT_UNSUPPORTED_AI}"
			Visibility="{Binding UnsupportedAIVisibility}" />
		<Label
			Grid.Column="0"
			Grid.Row="3"
			Content="{hlp:Localize PARAM_OBJECT_SEARCH}" />
		<Label
			Grid.Column="0"
			Grid.Row="4"
			Content="{hlp:Localize PARAM_OBJECT_BROWSER_SELECTED}" />
		<Label
			Grid.Column="0"
			Grid.Row="5"
			Content="{hlp:Localize PARAM_OBJECT_BROWSER_SIZE}"
			Visibility="{Binding EntitySizeVisibility}" />
		<UserControl
			Grid.ColumnSpan="2"
			Grid.Row="0"
			VerticalAlignment="Stretch"
			Content="{Binding ObjectSelector}" />
		<GridSplitter
			Grid.ColumnSpan="2"
			Grid.Row="1"
			ResizeDirection="Rows"
			HorizontalAlignment="Stretch"
			Height="5"
			VerticalAlignment="Stretch"
			ResizeBehavior="PreviousAndNext" />
		<TextBox
			Grid.Column="1"
			Grid.Row="2"
			IsEnabled="False"
			Text="{Binding Path=UnsupportedAI, Mode=OneWay}"
			Visibility="{Binding UnsupportedAIVisibility}" />
		<TextBox
			Grid.Column="1"
			Grid.Row="3"
			Text="{Binding Path=SearchObjInv, UpdateSourceTrigger=Explicit}"
			PreviewKeyDown="Search_OnPreviewKeyDown"
			LostFocus="Search_OnLostFocus" />
		<TextBox
			Grid.Column="1"
			Grid.Row="4"
			IsEnabled="False"
			Text="{Binding ObjectSelector.SelectedItem.Text, Mode=OneWay}" />
		<TextBox
			Grid.Column="1"
			Grid.Row="5"
			IsEnabled="False"
			Text="{Binding ObjectSelector.SelectedItem.SizeText, Mode=OneWay}"
			Visibility="{Binding EntitySizeVisibility}" />
	</Grid>
</UserControl>
