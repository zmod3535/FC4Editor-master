<Window
	x:Class="IGE.Views.NewMapDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:IGE.ViewModels.Validation" xmlns:hlp="clr-namespace:IGE.Helpers"
	Height="135"
	Width="400"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterScreen" xmlns:views="clr-namespace:IGE.Views"
	Title="{Binding DialogTitle}">
	<Grid>
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Grid}"
					x:Key="{x:Type Grid}">
					<Setter
						Property="Margin"
						Value="10" />
				</Style>
				<Style
					TargetType="{x:Type Label}"
					x:Key="{x:Type Label}">
					<Setter
						Property="Margin"
						Value="0,3,5,5" />
					<Setter
						Property="Padding"
						Value="0,0,0,5" />
				</Style>
				<Style
					TargetType="{x:Type ComboBox}"
					x:Key="{x:Type ComboBox}">
					<Setter
						Property="Margin"
						Value="0,0,0,5" />
				</Style>
				<Style
					TargetType="{x:Type StackPanel}"
					x:Key="{x:Type StackPanel}">
					<Setter
						Property="StackPanel.Orientation"
						Value="Horizontal" />
					<Setter
						Property="HorizontalAlignment"
						Value="Right" />
				</Style>
				<Style
					TargetType="{x:Type Button}"
					x:Key="{x:Type Button}">
					<Setter
						Property="Width"
						Value="70" />
					<Setter
						Property="Height"
						Value="25" />
					<Setter
						Property="Margin"
						Value="5,0,0,0" />
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto"
				MaxWidth="200" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Label
			Grid.Column="0"
			Grid.Row="0"
			Content="{Binding ObjectiveLabel}" />
		<Label
			Grid.Column="0"
			Grid.Row="1"
			Content="{Binding TerainLabel}" />
		<ComboBox
			Name="ObjectiveComboBox"
			Grid.Column="1"
			Grid.Row="0"
			ItemsSource="{Binding ObjectiveList}"
			SelectedItem="{Binding SelectedObjectiveListItem}" />
		<ComboBox
			Name="TerrainComboBox"
			Grid.Column="1"
			Grid.Row="1"
			ItemsSource="{Binding TerrainList}"
			SelectedItem="{Binding SelectedTerrainListItem}" />
		<StackPanel
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Grid.Row="2">
			<Button
				Name="OkButton"
				IsDefault="True"
				Content="_OK"
				Click="OkButton_Click" />
			<Button
				Name="CancelButton"
				IsCancel="True"
				Content="{hlp:Localize PROMPT_CANCEL}"
				Click="CancelButton_Click" />
		</StackPanel>
	</Grid>
</Window>
