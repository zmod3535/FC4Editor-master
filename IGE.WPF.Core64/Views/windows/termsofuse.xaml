<Window
	x:Class="IGE.Views.TermsOfUse" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlp="clr-namespace:IGE.Helpers"
	Title="Terms"
	Height="407"
	Width="533" xmlns:views="clr-namespace:IGE.Views">
	<Grid
		Margin="10,0,0,0">
		<Button
			Name="btnCancel"
			HorizontalAlignment="Right"
			Margin="0,0,10,10"
			VerticalAlignment="Bottom"
			Width="75"
			Content="{hlp:Localize PROMPT_CANCEL}"
			Click="btnCancel_Click" />
		<Button
			Name="btnOk"
			Content="_OK"
			HorizontalAlignment="Right"
			Margin="0,0,90,10"
			VerticalAlignment="Bottom"
			Width="75"
			Click="btnOk_Click" />
		<TextBox
			Name="ebTerms"
			IsReadOnly="True"
			Margin="0,10,10,37"
			TextWrapping="Wrap"
			Text="TextBox"
			ScrollViewer.VerticalScrollBarVisibility="Auto" />
	</Grid>
</Window>
