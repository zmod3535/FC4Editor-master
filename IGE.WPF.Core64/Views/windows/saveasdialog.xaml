<Window
	x:Class="IGE.Views.SaveAsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:IGE.ViewModels.Validation" xmlns:hlp="clr-namespace:IGE.Helpers"
	Height="105"
	Width="400"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterScreen" xmlns:views="clr-namespace:IGE.Views"
	Title="{Binding DialogTitle}">
	<Grid>
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Grid}"
					x:Key="{x:Type Grid}">
					<Setter
						Property="Margin"
						Value="10" />
				</Style>
				<Style
					TargetType="{x:Type Label}"
					x:Key="{x:Type Label}">
					<Setter
						Property="Margin"
						Value="0,3,5,5" />
					<Setter
						Property="Padding"
						Value="0,0,0,5" />
				</Style>
				<Style
					TargetType="{x:Type TextBox}"
					x:Key="{x:Type TextBox}">
					<Setter
						Property="Margin"
						Value="0,0,0,5" />
					<Style.Triggers>
						<Trigger
							Property="Validation.HasError"
							Value="True">
							<Setter
								Property="FrameworkElement.ToolTip"
								Value="{Binding Path=(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
						</Trigger>
					</Style.Triggers>
				</Style>
				<Style
					TargetType="{x:Type StackPanel}"
					x:Key="{x:Type StackPanel}">
					<Setter
						Property="StackPanel.Orientation"
						Value="Horizontal" />
					<Setter
						Property="HorizontalAlignment"
						Value="Right" />
				</Style>
				<Style
					TargetType="{x:Type Button}"
					x:Key="{x:Type Button}">
					<Setter
						Property="Width"
						Value="70" />
					<Setter
						Property="Height"
						Value="25" />
					<Setter
						Property="Margin"
						Value="5,0,0,0" />
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="100" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Label
			Grid.Column="0"
			Grid.Row="0"
			Content="{Binding MapNameLabel}" />
		<TextBox
			Name="MapNameTextBox"
			Grid.Column="1"
			Grid.Row="0"
			MaxLength="20">
			<TextBox.Text>
				<Binding
					Path="MapName"
					UpdateSourceTrigger="PropertyChanged">
					<Binding.ValidationRules>
						<v:EmptyStringValidator
							ValidatesOnTargetUpdated="True" />
					</Binding.ValidationRules>
				</Binding>
			</TextBox.Text>
		</TextBox>
		<StackPanel
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Grid.Row="1">
			<Button
				Name="OkButton"
				IsDefault="True"
				Content="_OK"
				Click="OkButton_Click" />
			<Button
				Name="CancelButton"
				IsCancel="True"
				Content="{hlp:Localize PROMPT_CANCEL}"
				Click="CancelButton_Click" />
		</StackPanel>
	</Grid>
</Window>
