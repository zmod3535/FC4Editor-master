<Window
	x:Class="IGE.Views.OpenDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlp="clr-namespace:IGE.Helpers"
	WindowStartupLocation="CenterScreen"
	Height="300"
	Width="450" xmlns:views="clr-namespace:IGE.Views"
	Title="{Binding DialogTitle}">
	<Grid>
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Grid}"
					x:Key="{x:Type Grid}">
					<Setter
						Property="Margin"
						Value="10" />
				</Style>
				<Style
					TargetType="{x:Type StackPanel}"
					x:Key="{x:Type StackPanel}">
					<Setter
						Property="StackPanel.Orientation"
						Value="Horizontal" />
					<Setter
						Property="HorizontalAlignment"
						Value="Right" />
				</Style>
				<Style
					TargetType="{x:Type Button}"
					x:Key="{x:Type Button}">
					<Setter
						Property="Width"
						Value="70" />
					<Setter
						Property="Height"
						Value="25" />
					<Setter
						Property="Margin"
						Value="5,5,0,0" />
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="150*" />
			<ColumnDefinition
				Width="300*" />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="0"
			Text="{Binding CategoryLabel}" />
		<TextBlock
			Grid.Column="1"
			Text="{Binding MapLabel}" />
		<ListBox
			Name="CategoryListBox"
			Grid.Row="1"
			Grid.Column="0"
			SelectionMode="Single"
			ItemsSource="{Binding CategoryList}"
			SelectedItem="{Binding Category}"
			SelectionChanged="CategoryListBox_SelectionChanged" />
		<ListBox
			Name="MapListBox"
			Grid.Row="1"
			Grid.Column="1"
			SelectionMode="Single"
			ItemsSource="{Binding MapList}"
			SelectedItem="{Binding MapName}"
			SelectionChanged="MapListBox_SelectionChanged">
			<ItemsControl.ItemContainerStyle>
				<!--Неизвестный ID соединения: 3-->
				<Style
					BasedOn="{StaticResource ListBoxItem}"
					TargetType="{x:Type ListBoxItem}" />
			</ItemsControl.ItemContainerStyle>
		</ListBox>
		<StackPanel
			Grid.Row="2"
			Grid.ColumnSpan="2">
			<Button
				Name="OkButton"
				IsEnabled="False"
				IsDefault="True"
				Content="_OK"
				Click="OkButton_Click" />
			<Button
				Name="CancelButton"
				IsCancel="True"
				Content="{hlp:Localize PROMPT_CANCEL}"
				Click="CancelButton_Click" />
		</StackPanel>
	</Grid>
</Window>
