<Window
	x:Class="IGE.Views.PromptInventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlp="clr-namespace:IGE.Helpers" xmlns:viewmodels="clr-namespace:IGE.ViewModels" xmlns:views="clr-namespace:IGE.Views" xmlns:params="clr-namespace:IGE.Parameters"
	Width="312"
	Height="338"
	WindowStartupLocation="CenterOwner"
	Title="{hlp:Localize PROMPT_INVENTORY_TITLE}">
	<FrameworkElement.DataContext>
		<viewmodels:PromptInventoryViewModel />
	</FrameworkElement.DataContext>
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<DataTemplate
				DataType="{x:Type params:InventoryTreeViewModel}"
				x:Key="{DataTemplateKey {x:Type params:InventoryTreeViewModel}}">
				<views:InventoryTreeView />
			</DataTemplate>
			<DataTemplate
				DataType="{x:Type params:InventoryTreeItemViewModel}"
				x:Key="{DataTemplateKey {x:Type params:InventoryTreeItemViewModel}}">
				<views:InventoryTreeItemView />
			</DataTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<DockPanel>
		<TextBlock
			DockPanel.Dock="Top"
			Text="{hlp:Localize PROMPT_INVENTORY_TEXT}" />
		<StackPanel
			DockPanel.Dock="Bottom"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Margin="2"
				Width="75"
				IsDefault="True"
				Content="{hlp:Localize PROMPT_OK}"
				IsEnabled="{Binding Tree.HasSelectedItem}"
				Click="ButtonOk_Click" />
			<Button
				Margin="2"
				Width="75"
				IsCancel="True"
				Content="{hlp:Localize PROMPT_CANCEL}"
				Click="ButtonCancel_Click" />
		</StackPanel>
		<StackPanel />
		<UserControl
			Content="{Binding Tree}" />
	</DockPanel>
</Window>
