<Window
	x:Class="IGE.Views.EditMapDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlp="clr-namespace:IGE.Helpers"
	Height="150"
	Width="400"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterScreen" xmlns:views="clr-namespace:IGE.Views"
	Title="{Binding DialogTitle}">
	<Grid>
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Grid}"
					x:Key="{x:Type Grid}">
					<Setter
						Property="Margin"
						Value="10" />
				</Style>
				<Style
					TargetType="{x:Type Label}"
					x:Key="{x:Type Label}">
					<Setter
						Property="Margin"
						Value="0,3,5,5" />
					<Setter
						Property="Padding"
						Value="0,0,0,5" />
				</Style>
				<Style
					TargetType="{x:Type ComboBox}"
					x:Key="{x:Type ComboBox}">
					<Setter
						Property="Margin"
						Value="0,0,0,5" />
				</Style>
				<Style
					TargetType="{x:Type StackPanel}"
					x:Key="{x:Type StackPanel}">
					<Setter
						Property="StackPanel.Orientation"
						Value="Horizontal" />
					<Setter
						Property="HorizontalAlignment"
						Value="Right" />
				</Style>
				<Style
					TargetType="{x:Type Button}"
					x:Key="{x:Type Button}">
					<Setter
						Property="Width"
						Value="70" />
					<Setter
						Property="Height"
						Value="25" />
					<Setter
						Property="Margin"
						Value="5,0,0,0" />
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="100" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock
			Grid.ColumnSpan="2"
			Grid.Row="0"
			TextWrapping="Wrap"
			Text="{Binding WarningText}" />
		<Label
			Grid.Column="0"
			Grid.Row="1"
			Content="{Binding ObjectiveLabel}" />
		<ComboBox
			Name="ObjectiveComboBox"
			Grid.Column="1"
			Grid.Row="1"
			ItemsSource="{Binding ObjectiveList}"
			SelectedItem="{Binding SelectedObjectiveListItem}" />
		<StackPanel
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Grid.Row="2">
			<Button
				Name="OkButton"
				IsDefault="True"
				Content="_OK"
				Click="OkButton_Click" />
			<Button
				Name="CancelButton"
				IsCancel="True"
				Content="{hlp:Localize PROMPT_CANCEL}"
				Click="CancelButton_Click" />
		</StackPanel>
	</Grid>
</Window>
