<Button
	x:Class="IGE.Views.ToolbarActionButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	BorderThickness="0"
	BorderBrush="#00FFFFFF"
	Background="#00FFFFFF" xmlns:views="clr-namespace:IGE.Views"
	Command="{Binding ButtonCommand}"
	ToolTip="{Binding ToolTip}">
	<Image
		Width="32"
		Height="32"
		Source="{Binding ImageSource}" />
</Button>
