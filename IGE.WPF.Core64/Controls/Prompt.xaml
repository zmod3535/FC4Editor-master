<Window
	x:Class="IGE.Controls.Prompt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hlp="clr-namespace:IGE.Helpers"
	SizeToContent="Height"
	WindowStartupLocation="CenterOwner"
	Width="400" xmlns:controls="clr-namespace:IGE.Controls">
	<StackPanel
		FocusManager.FocusedElement="{Binding ElementName=TxtInput}">
		<TextBlock
			Name="TxtPrompt"
			TextWrapping="Wrap" />
		<TextBox
			Name="TxtInput"
			KeyDown="TxtInput_KeyDown" />
		<StackPanel
			Orientation="Horizontal"
			HorizontalAlignment="Right">
			<Button
				Content="_OK"
				Width="75"
				Margin="2"
				Click="ButtonOk_Click" />
			<Button
				Width="75"
				Margin="2"
				IsCancel="True"
				Content="{hlp:Localize PROMPT_CANCEL}"
				Click="ButtonCancel_Click" />
		</StackPanel>
	</StackPanel>
</Window>
