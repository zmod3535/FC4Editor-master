											To=".5"
											Duration="0" />
									</Storyboard>
								</vsm:VisualState>
								<vsm:VisualState
									Name="Disabled">
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Background"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0" />
										<DoubleAnimation
											Storyboard.TargetName="NormalText"
											Storyboard.TargetProperty="Opacity"
