	<Style xmlns:switching="clr-namespace:Divelements.SandDock.Switching"
		TargetType="{x:Type switching:WindowPreview}"
		x:Key="{x:Type switching:WindowPreview}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type switching:WindowPreview}">
					<DockPanel>
						<Border
							Name="PART_TitleBar"
							DockPanel.Dock="Top"
							BorderThickness="1,1,1,0"
							Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}"
							TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}"
							BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}">
							<DockPanel
								Margin="4,0,3,0">
								<StackPanel
									DockPanel.Dock="Right"
									Width="0">
									<Rectangle
										Height="{DynamicResource SystemParameters.SmallCaptionHeightKey}" />
									<Rectangle
										Height="{DynamicResource SystemParameters.ResizeFrameVerticalBorderWidthKey}" />
								</StackPanel>
								<TextBlock
									Name="PART_CaptionText"
									VerticalAlignment="Center"
									TextTrimming="CharacterEllipsis"
									Text="{Binding Path=Window.Title, RelativeSource={RelativeSource TemplatedParent}}"
									Style="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.SmallTitleBarStyle}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							</DockPanel>
						</Border>
						<Border
							Name="PART_MainBorder"
							BorderThickness="1,0,1,1"
							Padding="2,0,2,2"
							Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}"
							BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}">
							<Border
								Width="{Binding Path=WindowSize.Width, RelativeSource={RelativeSource TemplatedParent}}"
								Height="{Binding Path=WindowSize.Height, RelativeSource={RelativeSource TemplatedParent}}"
								Background="{Binding Path=Window.Background, RelativeSource={RelativeSource TemplatedParent}}">
								<Rectangle
									Name="PART_Preview" />
							</Border>
						</Border>
					</DockPanel>
					<ControlTemplate.Triggers>
						<DataTrigger
							Value="OriginalChild"
							Binding="{Binding Path=PreviewType, RelativeSource={RelativeSource Self}}">
							<Setter
								TargetName="PART_Preview"
								Property="Fill">
								<Setter.Value>
									<VisualBrush
										RenderOptions.CachingHint="Cache"
										AutoLayoutContent="False"
										Visual="{Binding Path=Window, RelativeSource={RelativeSource TemplatedParent}}" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
						<DataTrigger
							Value="TemporarySwap"
							Binding="{Binding Path=PreviewType, RelativeSource={RelativeSource Self}}">
							<Setter
								TargetName="PART_Preview"
								Property="Fill">
								<Setter.Value>
									<VisualBrush
										Stretch="None"
										RenderOptions.CachingHint="Cache"
										AutoLayoutContent="True"
										Visual="{Binding Path=SwappedContentPresenter, RelativeSource={RelativeSource TemplatedParent}}" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
						<DataTrigger
							Value="True"
							Binding="{Binding Path=Window.(local:Switching.WindowSwitcher.IsPreviewing), RelativeSource={RelativeSource Self}}">
							<Setter
								TargetName="PART_TitleBar"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<Setter
								TargetName="PART_TitleBar"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<Setter
								TargetName="PART_TitleBar"
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<Setter
								TargetName="PART_MainBorder"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<Setter
								TargetName="PART_MainBorder"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style xmlns:switching="clr-namespace:Divelements.SandDock.Switching"
		TargetType="{x:Type switching:WhidbeyWindowSelector}"
		x:Key="{x:Type switching:WhidbeyWindowSelector}">
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type ListBox}"
					x:Key="{x:Type ListBox}">
					<Setter
						Property="HorizontalContentAlignment"
						Value="Stretch" />
					<Setter
						Property="ItemTemplate">
						<Setter.Value>
							<DataTemplate>
								<Border
									Name="PART_Border"
									Padding="2"
									Style="{DynamicResource {ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItem}, TypeInTargetAssembly={x:Type local:DockSite}}}">
									<DockPanel>
										<Image
											DockPanel.Dock="Left"
											Width="16"
											VerticalAlignment="Center"
											Source="{Binding Path=Image}" />
										<TextBlock
											Margin="3,0,0,0"
											TextTrimming="CharacterEllipsis"
											VerticalAlignment="Center"
											Text="{Binding Path=TabText}" />
									</DockPanel>
								</Border>
								<DataTemplate.Triggers>
									<DataTrigger
										Value="True"
										Binding="{Binding Path=(local:Switching.WindowSwitcher.IsPreviewing)}">
										<Setter
											TargetName="PART_Border"
											Property="Style"
											Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItemSelected}, TypeInTargetAssembly={x:Type local:DockSite}}}" />
									</DataTrigger>
								</DataTemplate.Triggers>
							</DataTemplate>
						</Setter.Value>
					</Setter>
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type ListBox}">
								<StackPanel
									IsItemsHost="True" />
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ResourceDictionary>
		</Style.Resources>
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.ControlBrushKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource SystemColors.ActiveCaptionBrushKey}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="Padding"
			Value="8" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type switching:WhidbeyWindowSelector}">
					<localprimitives:DropShadow
						Offset="0,0"
						Distance="2"
						BorderThickness="14"
						Color="#60000000">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
							MinHeight="250">
							<DockPanel>
								<Border
									DockPanel.Dock="Bottom"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									Padding="12"
									Margin="0,8,0,0">
									<StackPanel>
										<TextBlock
											FontWeight="Bold"
											Margin="0,0,0,4"
											Text="{Binding Path=WindowSwitcher.PreviewingWindow.TabText, RelativeSource={RelativeSource TemplatedParent}}" />
										<TextBlock
											TextTrimming="CharacterEllipsis"
											MaxWidth="280"
											Text="{Binding Path=WindowSwitcher.PreviewingWindow.Description, RelativeSource={RelativeSource TemplatedParent}}" />
									</StackPanel>
								</Border>
								<StackPanel
									Orientation="Horizontal">
									<StackPanel
										Orientation="Vertical"
										Margin="0,0,5,0"
										MinWidth="150">
										<TextBlock
											FontWeight="Bold"
											Margin="0,0,0,6"
											Text="{Binding Path=WindowSwitcher.DockSite.LanguageStrings.ActiveToolWindows, RelativeSource={RelativeSource TemplatedParent}}" />
										<ListBox
											Name="PART_ToolWindowListBox"
											ItemsSource="{Binding Path=WindowSwitcher.ToolWindows, RelativeSource={RelativeSource TemplatedParent}}" />
									</StackPanel>
									<StackPanel
										Orientation="Vertical"
										Margin="5,0,0,0"
										MinWidth="150">
										<TextBlock
											FontWeight="Bold"
											Margin="0,0,0,6"
											Text="{Binding Path=WindowSwitcher.DockSite.LanguageStrings.ActiveFiles, RelativeSource={RelativeSource TemplatedParent}}" />
										<ListBox
											Name="PART_DocumentWindowListBox"
											ItemsSource="{Binding Path=WindowSwitcher.DocumentWindows, RelativeSource={RelativeSource TemplatedParent}}" />
									</StackPanel>
								</StackPanel>
							</DockPanel>
						</Border>
					</localprimitives:DropShadow>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style xmlns:switching="clr-namespace:Divelements.SandDock.Switching"
		TargetType="{x:Type switching:QuickTabWindowSelector}"
		x:Key="{x:Type switching:QuickTabWindowSelector}">
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="-0.5"
						Color="{DynamicResource SystemColors.ControlLightLightColorKey}" />
					<GradientStop
						Offset="2"
						Color="{DynamicResource SystemColors.ControlDarkDarkColorKey}" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type switching:QuickTabWindowSelector}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="15">
						<ListBox
							Name="PART_ItemsControl"
							Background="{DynamicResource SystemColors.ControlBrushKey}"
							BorderThickness="1"
							BorderBrush="{DynamicResource SystemColors.ControlDarkDarkBrushKey}"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							HorizontalAlignment="Center"
							ItemsSource="{Binding Path=Windows, RelativeSource={RelativeSource TemplatedParent}}">
							<Control.Template>
								<ControlTemplate
									TargetType="{x:Type ListBox}">
									<localprimitives:DropShadow
										Offset="0,0"
										BorderThickness="15"
										Distance="2">
										<Border
											Background="{TemplateBinding Background}"
											BorderBrush="{TemplateBinding BorderBrush}"
											BorderThickness="{TemplateBinding BorderThickness}"
											CornerRadius="8">
											<ScrollViewer
												Padding="5"
												Focusable="False">
												<ItemsPresenter />
											</ScrollViewer>
										</Border>
									</localprimitives:DropShadow>
								</ControlTemplate>
							</Control.Template>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border
										Name="PART_Border"
										Padding="8"
										Margin="5"
										Style="{DynamicResource {ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItem}, TypeInTargetAssembly={x:Type local:DockSite}}}">
										<StackPanel>
											<TextBlock
												Margin="0,0,0,3"
												Text="{Binding Path=Window.Title}" />
											<Viewbox
												Stretch="Uniform"
												Width="190"
												Height="130">
												<Border
													Width="{Binding Path=WindowSize.Width}"
													Height="{Binding Path=WindowSize.Height}"
													Background="{Binding Path=PreviewBrush}" />
											</Viewbox>
										</StackPanel>
									</Border>
									<DataTemplate.Triggers>
										<DataTrigger
											Value="True"
											Binding="{Binding Path=Window.(local:Switching.WindowSwitcher.IsPreviewing)}">
											<Setter
												TargetName="PART_Border"
												Property="Style"
												Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItemSelected}, TypeInTargetAssembly={x:Type local:DockSite}}}" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ListBox>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
