				Canvas.Left="0"
				Canvas.Top="30"
				Width="30"
				Height="29"
				Fill="#00FFFFFF" />
			<Rectangle
				Name="PART_RightArrow"
				Canvas.Left="59"
				Canvas.Top="30"
				Width="30"
				Height="29"
				Fill="#00FFFFFF" />
			<Rectangle
				Name="PART_UpArrow"
				Canvas.Left="30"
				Canvas.Top="0"
				Width="29"
				Height="30"
				Fill="#00FFFFFF" />
			<Rectangle
				Name="PART_DownArrow"
				Canvas.Left="30"
				Canvas.Top="59"
				Width="29"
				Height="30"
				Fill="#00FFFFFF" />
			<Rectangle
				Name="PART_CenterSpot"
				Canvas.Left="30"
				Canvas.Top="30"
				Width="29"
				Height="29"
				Fill="#00FFFFFF" />
		</Canvas>
	</ControlTemplate>
	<Style
		TargetType="{x:Type localprimitives:DockingHint}"
		x:Key="{x:Type localprimitives:DockingHint}">
		<Style.Triggers>
			<Trigger
				Property="localprimitives:DockingHint.DockingHintType"
				Value="BottomWindowEdge">
				<Setter
					Property="HorizontalAlignment"
					Value="Center" />
