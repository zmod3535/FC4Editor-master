			Width="88"
			Height="88"
			Background="{TemplateBinding Background}">
			<Path
				Stroke="#B5B5B5"
				Fill="#E4E4E4"
				Data="M0,29 L22,29 L29,22 L29,0 L57,0 L57,22 L64,29 L87,29 L87,57 L64,57 L57,64 L57,87 L29,87 L29,64 L22,57 L0,57" />
			<Image
				Canvas.Left="32"
				Canvas.Top="3"
				Source="{StaticResource TopDockIndicatorGlyph}" />
			<Image
				Canvas.Left="32"
				Canvas.Top="60"
				Source="{StaticResource BottomDockIndicatorGlyph}" />
			<Image
				Canvas.Left="3"
				Canvas.Top="32"
				Source="{StaticResource LeftDockIndicatorGlyph}" />
			<Image
				Canvas.Left="60"
				Canvas.Top="32"
				Source="{StaticResource RightDockIndicatorGlyph}" />
			<Image
				Canvas.Left="31"
				Canvas.Top="31"
				Source="{StaticResource MiddleDockIndicatorGlyph}" />
			<Rectangle
