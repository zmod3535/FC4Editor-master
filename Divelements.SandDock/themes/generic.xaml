								TargetName="PART_TextBlock"
								Property="Foreground"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
