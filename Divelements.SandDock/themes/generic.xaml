					Value="Right" />
				<Setter
					Property="VerticalAlignment"
					Value="Center" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type localprimitives:DockingHint}">
							<Canvas
