		TargetType="{x:Type localprimitives:ResizeControlSplitter}"
		x:Key="{x:Type localprimitives:ResizeControlSplitter}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type localprimitives:ResizeControlSplitter}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type localprimitives:PopupContainer}"
		x:Key="{x:Type localprimitives:PopupContainer}">
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.ControlBrushKey}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type localprimitives:PopupContainer}">
					<Border
						Name="Border"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<DockPanel
							Margin="{TemplateBinding Padding}">
							<localprimitives:PopupContainerSplitter
								Name="Splitter" />
							<ContentPresenter
								ContentSource="WindowGroup" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="Dock"
							Value="Left">
							<Setter
								TargetName="Splitter"
								Property="Dock"
								Value="Right" />
							<Setter
								TargetName="Splitter"
								Property="FrameworkElement.Cursor"
								Value="SizeWE" />
							<Setter
								TargetName="Border"
								Property="Width"
								Value="{Binding Path=WindowGroup.SelectedWindow.ContentSize, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="Dock"
							Value="Right">
							<Setter
								TargetName="Splitter"
								Property="Dock"
								Value="Left" />
							<Setter
								TargetName="Splitter"
								Property="FrameworkElement.Cursor"
								Value="SizeWE" />
							<Setter
								TargetName="Border"
								Property="Width"
								Value="{Binding Path=WindowGroup.SelectedWindow.ContentSize, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="Dock"
							Value="Top">
							<Setter
								TargetName="Splitter"
								Property="Dock"
								Value="Bottom" />
							<Setter
								TargetName="Splitter"
								Property="FrameworkElement.Cursor"
								Value="SizeNS" />
							<Setter
								TargetName="Border"
								Property="Height"
								Value="{Binding Path=WindowGroup.SelectedWindow.ContentSize, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger
							Property="Dock"
							Value="Bottom">
							<Setter
								TargetName="Splitter"
								Property="Dock"
								Value="Top" />
							<Setter
								TargetName="Splitter"
								Property="FrameworkElement.Cursor"
								Value="SizeNS" />
							<Setter
								TargetName="Border"
								Property="Height"
								Value="{Binding Path=WindowGroup.SelectedWindow.ContentSize, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
