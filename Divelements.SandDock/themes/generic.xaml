							<Setter
								TargetName="InnerBorder"
								Property="BorderThickness"
								Value="0" />
							<Setter
								TargetName="LeftColumn"
								Property="Width"
								Value="0" />
							<Setter
								TargetName="RightColumn"
								Property="Width"
								Value="0" />
							<Setter
								TargetName="TopRow"
								Property="Height"
								Value="0" />
							<Setter
								TargetName="BottomRow"
