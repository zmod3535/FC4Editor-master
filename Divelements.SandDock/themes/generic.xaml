<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Divelements.SandDock" xmlns:localprimitives="clr-namespace:Divelements.SandDock.Primitives" xmlns:rendering="clr-namespace:Divelements.SandDock.Rendering">
	<ResourceDictionary.MergedDictionaries>
		<rendering:ThemeDictionaryManager
			Type="Generic" />
	</ResourceDictionary.MergedDictionaries>
	<SolidColorBrush
		Color="{x:Static SystemColors.ActiveCaptionColor}"
		Opacity="0.4"
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DockPreviewBackgroundBrush}, TypeInTargetAssembly={x:Type local:RenderingElement}}" />
	<SolidColorBrush
		Color="LightGray"
		Opacity="0.5"
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DockPreviewBorderBrush}, TypeInTargetAssembly={x:Type local:RenderingElement}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="1,0"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}">
		<GradientStop
			Offset="0"
			Color="{DynamicResource SystemColors.InactiveCaptionColorKey}" />
		<GradientStop
			Offset="1"
			Color="{DynamicResource SystemColors.GradientInactiveCaptionColorKey}" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveBorderColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveCaptionTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="1,0"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}">
		<GradientStop
			Offset="0"
			Color="{DynamicResource SystemColors.ActiveCaptionColorKey}" />
		<GradientStop
			Offset="1"
			Color="{DynamicResource SystemColors.GradientActiveCaptionColorKey}" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveBorderColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveCaptionTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveBorderColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveBorderColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveBorderColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveBorderColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<Style
		TargetType="{x:Type TextBlock}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.TitleBarStyle}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}">
		<Setter
			Property="FontFamily"
			Value="{DynamicResource SystemFonts.CaptionFontFamilyKey}" />
		<Setter
			Property="FontWeight"
			Value="{DynamicResource SystemFonts.CaptionFontWeightKey}" />
		<Setter
			Property="FontSize"
			Value="{DynamicResource SystemFonts.CaptionFontSizeKey}" />
		<Setter
			Property="FontStyle"
			Value="{DynamicResource SystemFonts.CaptionFontStyleKey}" />
	</Style>
	<Style
		TargetType="{x:Type TextBlock}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.SmallTitleBarStyle}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}">
		<Setter
			Property="FontFamily"
			Value="{DynamicResource SystemFonts.SmallCaptionFontFamilyKey}" />
		<Setter
			Property="FontWeight"
			Value="{DynamicResource SystemFonts.SmallCaptionFontWeightKey}" />
		<Setter
			Property="FontSize"
			Value="{DynamicResource SystemFonts.SmallCaptionFontSizeKey}" />
		<Setter
			Property="FontStyle"
			Value="{DynamicResource SystemFonts.SmallCaptionFontStyleKey}" />
	</Style>
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveCaptionButtonForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<Style
		TargetType="{x:Type localprimitives:WindowTab}"
		x:Key="{x:Type localprimitives:WindowTab}">
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowTabTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}}" />
	</Style>
	<Style
		TargetType="{x:Type local:WindowGroup}"
		x:Key="{x:Type local:WindowGroup}">
		<Setter
			Property="Template"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowGroupTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}}" />
		<Setter
			Property="rendering:Themes.IsHighContrast"
			Value="{DynamicResource SystemParameters.HighContrastKey}" />
	</Style>
	<Style
		TargetType="{x:Type local:DockSite}"
		x:Key="{x:Type local:DockSite}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DockSiteBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}}" />
		<Setter
			Property="rendering:Themes.IsHighContrast"
			Value="{DynamicResource SystemParameters.HighContrastKey}" />
		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type local:WindowGroup}"
					x:Key="{x:Type local:WindowGroup}">
					<Style.Resources>
						<ResourceDictionary>
							<Style
								TargetType="{x:Type localprimitives:WindowTab}"
								x:Key="{x:Type localprimitives:WindowTab}">
								<Setter
									Property="Template"
									Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowTabTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}}" />
							</Style>
						</ResourceDictionary>
					</Style.Resources>
					<Setter
						Property="Template"
						Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowGroupTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}}" />
					<Setter
						Property="rendering:Themes.IsHighContrast"
						Value="{DynamicResource SystemParameters.HighContrastKey}" />
				</Style>
			</ResourceDictionary>
		</Style.Resources>
		<Style.Triggers>
			<Trigger
				Property="rendering:Themes.IsHighContrast"
				Value="True">
				<Setter
					Property="Background"
					Value="{DynamicResource SystemColors.ControlBrushKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type local:DocumentContainer}"
		x:Key="{x:Type local:DocumentContainer}">
		<Style.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type local:WindowGroup}"
					x:Key="{x:Type local:WindowGroup}">
					<Style.Resources>
						<ResourceDictionary>
							<Style
								TargetType="{x:Type localprimitives:WindowTab}"
								x:Key="{x:Type localprimitives:WindowTab}">
								<Setter
									Property="Template"
									Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DocumentWindowTabTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}}" />
							</Style>
						</ResourceDictionary>
					</Style.Resources>
					<Setter
						Property="Template"
						Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DocumentWindowGroupTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}}" />
					<Setter
						Property="rendering:Themes.IsHighContrast"
						Value="{DynamicResource SystemParameters.HighContrastKey}" />
				</Style>
			</ResourceDictionary>
		</Style.Resources>
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerEmptyBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerBorderBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}}" />
		<Setter
			Property="BorderThickness"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerBorderThickness}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:DocumentContainer}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="HasContent"
				Value="True">
				<Setter
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerPopulatedBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type local:DockableWindow}"
		x:Key="{x:Type local:DockableWindow}">
		<Setter
			Property="local:DockableWindow.Image"
			Value="{StaticResource DefaultTabImage}" />
		<Setter
			Property="local:DockableWindow.TabForeground"
			Value="{DynamicResource SystemColors.ControlTextBrushKey}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:DockableWindow}">
					<AdornerDecorator>
						<Border
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}">
							<ContentPresenter
								ContentSource="Child" />
						</Border>
					</AdornerDecorator>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type local:DocumentWindow}"
		x:Key="{x:Type local:DocumentWindow}">
		<Setter
			Property="local:DockableWindow.Image"
			Value="{StaticResource DefaultTabImage}" />
		<Setter
			Property="local:DockableWindow.TabForeground"
			Value="{DynamicResource SystemColors.ControlTextBrushKey}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type local:DockableWindow}">
					<AdornerDecorator>
						<Border
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}">
							<ContentPresenter
								ContentSource="Child" />
						</Border>
					</AdornerDecorator>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style xmlns:switching="clr-namespace:Divelements.SandDock.Switching"
		TargetType="{x:Type switching:Tab3DWindowSelector}"
		x:Key="{x:Type switching:Tab3DWindowSelector}">
		<Setter
			Property="Background"
			Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerEmptyBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}}" />
		<Setter
			Property="Foreground"
			Value="{x:Static SystemColors.ControlLightLightBrush}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type switching:Tab3DWindowSelector}">
					<Border
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="3*" />
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<Viewport3D
								Name="PART_Viewport"
								Grid.RowSpan="2"
								ClipToBounds="False"
								TextElement.Foreground="{Binding Path=WindowSwitcher.PreviewingWindow.Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
							<StackPanel
								Name="PART_WindowDescription"
								Grid.Row="1"
								Margin="10"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Background="#BB000000">
								<TextBlock
									FontSize="16"
									TextAlignment="Center"
									Margin="6"
									Text="{Binding Path=WindowSwitcher.PreviewingWindow.TabText, RelativeSource={RelativeSource TemplatedParent}}" />
								<TextBlock
									TextAlignment="Center"
									MaxWidth="400"
									TextWrapping="Wrap"
									Margin="6"
									Text="{Binding Path=WindowSwitcher.PreviewingWindow.Description, RelativeSource={RelativeSource TemplatedParent}}" />
							</StackPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<DataTrigger
							Binding="{Binding Path=WindowSwitcher.PreviewingWindow, RelativeSource={RelativeSource Self}}"
							Value="{x:Null}">
							<Setter
								TargetName="PART_WindowDescription"
								Property="Visibility"
								Value="Hidden" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type localprimitives:SystemCaptionButton}"
		x:Key="{x:Type localprimitives:SystemCaptionButton}">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type localprimitives:SystemCaptionButton}">
					<Border
						BorderBrush="#FFFFFFFF"
						BorderThickness="1"
						CornerRadius="{TemplateBinding localprimitives:CornerRadius}"
						Background="{TemplateBinding Background}"
						Margin="2">
						<Grid>
							<Border
								Name="PART_Border"
								Margin="1">
								<Border.Background>
									<RadialGradientBrush
										Center="0,0"
										GradientOrigin="0,0"
										RadiusX="1"
										RadiusY="1">
										<GradientStop
											Offset="0"
											Color="#88FFFFFF" />
										<GradientStop
											Offset="1"
											Color="#22FFFFFF" />
									</RadialGradientBrush>
								</Border.Background>
							</Border>
							<ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="PART_Border"
								Property="Background">
								<Setter.Value>
									<RadialGradientBrush
										Center="0,0"
										GradientOrigin="0,0"
										RadiusX="1"
										RadiusY="1">
										<GradientStop
											Offset="0"
											Color="#AAFFFFFF" />
										<GradientStop
											Offset="1"
											Color="#44FFFFFF" />
									</RadialGradientBrush>
								</Setter.Value>
							</Setter>
						</Trigger>
						<Trigger
							Property="IsPressed"
							Value="True">
							<Setter
								TargetName="PART_Border"
								Property="Background">
								<Setter.Value>
									<RadialGradientBrush
										Center="0,0"
										GradientOrigin="0,0"
										RadiusX="1"
										RadiusY="1">
										<GradientStop
											Offset="0"
											Color="#55000000" />
										<GradientStop
											Offset="1"
											Color="#22000000" />
									</RadialGradientBrush>
								</Setter.Value>
							</Setter>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		TargetType="{x:Type localprimitives:MdiWindowContainer}"
		x:Key="{x:Type localprimitives:MdiWindowContainer}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type localprimitives:MdiWindowContainer}">
					<Grid>
						<localprimitives:DropShadow
							Name="PART_Shadow"
							Offset="0,0"
							Distance="2"
							BorderThickness="14"
							Color="Transparent"
							IsHitTestVisible="False" />
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition
									Name="TopRow"
									Height="4" />
								<RowDefinition
									Name="TitlebarRow"
									Height="21" />
								<RowDefinition
									Name="ContentRow"
									Height="*" />
								<RowDefinition
									Name="BottomRow"
									Height="4" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Name="LeftColumn"
									Width="4" />
								<ColumnDefinition
									Name="ContentColumn"
									Width="*" />
								<ColumnDefinition
									Name="RightColumn"
									Width="4" />
							</Grid.ColumnDefinitions>
							<Border
								Name="PART_TitleBar"
								Grid.Row="0"
								Grid.RowSpan="2"
								Grid.ColumnSpan="3"
								CornerRadius="6,6,0,0"
								Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<DockPanel
								Grid.Row="1"
								Grid.Column="1"
								Margin="0,0,0,1">
								<StackPanel
									DockPanel.Dock="Right"
									Width="0">
									<Rectangle
										Name="PART_CaptionHeightEnforcer"
										Height="{DynamicResource SystemParameters.CaptionHeightKey}" />
									<Rectangle
										Name="PART_BorderHeightEnforcer"
										Height="{DynamicResource SystemParameters.ResizeFrameVerticalBorderWidthKey}" />
								</StackPanel>
								<localprimitives:SystemCaptionButton
									Name="PART_CloseButton"
									Command="{x:Static ApplicationCommands.Close}"
									Background="#E45127"
									DockPanel.Dock="Right"
									CornerRadius="2.5"
									Foreground="#FFFFFF"
									Width="20"
									Height="20">
									<TextBlock
										Name="PART_CloseLabel"
										FontFamily="Marlett"
										FontSize="9.75"
										Text="r" />
								</localprimitives:SystemCaptionButton>
								<localprimitives:SystemCaptionButton
									Name="PART_MaximizeButton"
									IsEnabled="{TemplateBinding CanMaximize}"
									DockPanel.Dock="Right"
									CornerRadius="2.5"
									Width="20"
									Height="20"
									Background="{Binding ElementName=PART_TitleBar, Path=(Border.Background)}"
									Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveCaptionButtonForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}">
									<UIElement.RenderTransform>
										<TranslateTransform
											X="2" />
									</UIElement.RenderTransform>
									<TextBlock
										Name="PART_MaximizeLabel"
										FontFamily="Marlett"
										FontSize="8"
										Text="1" />
								</localprimitives:SystemCaptionButton>
								<localprimitives:SystemCaptionButton
									Name="PART_MinimizeButton"
									IsEnabled="{TemplateBinding CanMinimize}"
									DockPanel.Dock="Right"
									CornerRadius="2.5"
									Width="20"
									Height="20"
									Background="{Binding ElementName=PART_TitleBar, Path=(Border.Background)}"
									Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveCaptionButtonForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}">
									<UIElement.RenderTransform>
										<TranslateTransform
											X="4" />
									</UIElement.RenderTransform>
									<TextBlock
										Name="PART_MinimizeLabel"
										FontFamily="Marlett"
										FontSize="8"
										Text="0" />
								</localprimitives:SystemCaptionButton>
								<Image
									Name="PART_SystemIcon"
									DockPanel.Dock="Left"
									Source="{TemplateBinding localprimitives:Icon}"
									Width="16"
									VerticalAlignment="Center"
									Margin="0,1,4,0" />
								<TextBlock
									Name="PART_TextBlock"
									IsHitTestVisible="False"
									VerticalAlignment="Center"
									Text="{TemplateBinding localprimitives:Title}"
									TextTrimming="CharacterEllipsis"
									Style="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.TitleBarStyle}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}"
									Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							</DockPanel>
							<Border
								Name="PART_MainBorder"
								Grid.Row="2"
								Grid.RowSpan="2"
								Grid.ColumnSpan="3"
								Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}"
								BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<Border
								Name="ContentArea"
								Grid.Row="2"
								Grid.Column="1">
								<AdornerDecorator>
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											Name="ContentPresenter"
											ClipToBounds="True" />
									</Border>
								</AdornerDecorator>
							</Border>
							<Border
								Name="OuterBorder"
								Grid.RowSpan="4"
								Grid.ColumnSpan="3"
								IsHitTestVisible="False"
								CornerRadius="6,6,0,0"
								BorderThickness="1"
								BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}">
								<Border
									Name="InnerBorder"
									CornerRadius="5,5,0,0"
									BorderThickness="1"
									BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							</Border>
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="localprimitives:MdiWindowContainer.HasDropShadow"
									Value="True" />
								<Condition
									Property="UIElement.IsKeyboardFocusWithin"
									Value="False" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_Shadow"
								Property="localprimitives:DropShadow.Color"
								Value="#20000000" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition
									Property="localprimitives:MdiWindowContainer.HasDropShadow"
									Value="True" />
								<Condition
									Property="UIElement.IsKeyboardFocusWithin"
									Value="True" />
							</MultiTrigger.Conditions>
							<Setter
								TargetName="PART_Shadow"
								Property="localprimitives:DropShadow.Color"
								Value="#60000000" />
						</MultiTrigger>
						<Trigger
							Property="localprimitives:MdiWindowContainer.WindowStyle"
							Value="ToolWindow">
							<Setter
								TargetName="PART_TextBlock"
								Property="Style"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.SmallTitleBarStyle}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}}" />
							<Setter
								TargetName="PART_CaptionHeightEnforcer"
								Value="{DynamicResource SystemParameters.SmallCaptionHeightKey}"
								Property="Height" />
							<Setter
								TargetName="TitlebarRow"
								Property="Height"
								Value="18" />
							<Setter
								TargetName="OuterBorder"
								Property="Border.CornerRadius"
								Value="0" />
