<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Divelements.SandDock" xmlns:rendering="clr-namespace:Divelements.SandDock.Rendering">
	<ResourceDictionary.MergedDictionaries>
		<rendering:ThemeDictionaryManager
			Type="LunaSilver" />
	</ResourceDictionary.MergedDictionaries>
	<SolidColorBrush
		Color="Silver"
		Opacity="0.45"
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DockPreviewBackgroundBrush}, TypeInTargetAssembly={x:Type local:RenderingElement}}" />
	<SolidColorBrush
		Color="LightGray"
		Opacity="0.5"
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DockPreviewBorderBrush}, TypeInTargetAssembly={x:Type local:RenderingElement}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}">
		<GradientStop
			Offset="0"
			Color="#FFFFFF" />
		<GradientStop
			Offset="0.3"
			Color="#D7D7E3" />
		<GradientStop
			Offset="0.6"
			Color="#E8E9F1" />
		<GradientStop
			Offset="1"
			Color="#FDFFFC" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#C9C9D7"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveCaptionTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}">
		<GradientStop
			Offset="0"
			Color="#FFFFFF" />
		<GradientStop
			Offset="0.3"
			Color="#A8A7BF" />
		<GradientStop
			Offset="0.6"
			Color="#CBCDD9" />
		<GradientStop
			Offset="1"
			Color="#FFFFFF" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#66667E"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveCaptionTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="#C9C9D7"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="#FDFFFC"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.InactiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="#66667E"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveOuterBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="#FBFCFD"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveInnerBorderBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
	<SolidColorBrush
		Color="#6E6D8F"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:WindowFrameElements.ActiveCaptionButtonForegroundBrush}, TypeInTargetAssembly={x:Type rendering:WindowFrameElements}}" />
</ResourceDictionary>
