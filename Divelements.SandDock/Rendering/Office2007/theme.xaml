						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="ItemTemplate">
					<Setter.Value>
						<DataTemplate>
							<Border
								Name="TabBorder"
								CornerRadius="0,3.5,3.5,0"
								BorderThickness="0,1,1,1"
								MinWidth="20"
								Padding="1,3,2,3"
								Margin="0,-1,2,0"
