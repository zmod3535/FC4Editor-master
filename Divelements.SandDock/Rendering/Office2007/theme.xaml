					Width="16"
					Height="15"
					DockPanel.Dock="Right"
					Padding="1"
					Margin="0,0,3,0"
					Template="{StaticResource TitleBarButtonTemplate}"
					CommandTarget="{Binding Path=SelectedWindow, RelativeSource={RelativeSource TemplatedParent}}"
					ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.Close, RelativeSource={RelativeSource TemplatedParent}}">
					<TextBlock
						FontFamily="Marlett"
						FontSize="12"
						Text="r" />
				</Button>
				<Menu
					Background="#00FFFFFF"
					DockPanel.Dock="Right"
					VerticalAlignment="Center"
					IsMainMenu="False">
					<MenuItem
						DockPanel.Dock="Right"
						HorizontalContentAlignment="Left"
						Margin="0"
						Width="16"
						Height="15"
						Padding="1"
						Template="{StaticResource TopLevelMenuItemTemplate}"
						ItemsSource="{Binding Path=Items, RelativeSource={RelativeSource TemplatedParent}}"
						ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.ActiveFiles, RelativeSource={RelativeSource TemplatedParent}}">
						<HeaderedItemsControl.Header>
							<TextBlock
								Margin="1,0,-1,0"
								FontFamily="Marlett"
								Text="u"
								FontSize="12" />
						</HeaderedItemsControl.Header>
						<ItemsControl.ItemContainerStyle>
							<Style
								TargetType="{x:Type MenuItem}">
								<Setter
									Property="Header"
									Value="{Binding Path=TabText}" />
								<Setter
									Property="MenuItem.Command"
									Value="{x:Static local:DockableWindow.OpenCommand}" />
								<Setter
									Property="MenuItem.CommandTarget"
									Value="{Binding}" />
								<Setter
									Property="Template"
									Value="{StaticResource MenuItemTemplate}" />
								<Setter
									Property="Padding"
									Value="2,4,2,5" />
								<Setter
									Property="MenuItem.Icon"
									Value="{Binding Path=Image}" />
							</Style>
						</ItemsControl.ItemContainerStyle>
					</MenuItem>
				</Menu>
				<ScrollViewer
					Name="Scroller"
					VerticalScrollBarVisibility="Hidden"
					HorizontalScrollBarVisibility="Hidden"
					Margin="0,0,0,-1"
					Focusable="False">
					<localprimitives:WindowList
						Name="PART_WindowList"
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						ItemsSource="{Binding Path=Windows, RelativeSource={RelativeSource TemplatedParent}}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel
									Margin="12,0,0,0"
									Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</localprimitives:WindowList>
				</ScrollViewer>
			</DockPanel>
		</Grid>
	</ControlTemplate>
	<Style
		TargetType="{x:Type localprimitives:UnpinnedTabStrip}"
		x:Key="{x:Type localprimitives:UnpinnedTabStrip}">
		<Setter
			Property="Dock"
			Value="{Binding Path=(local:DockSite.Dock), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type localprimitives:UnpinnedTray}}}" />
		<Setter
			Property="ItemsSource"
			Value="{Binding Path=WindowGroup.Items, RelativeSource={RelativeSource Self}}" />
