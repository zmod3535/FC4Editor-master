								HorizontalAlignment="Left" />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="ItemTemplate">
					<Setter.Value>
						<DataTemplate>
							<Border
								Name="TabBorder"
								CornerRadius="3.5,3.5,0,0"
								BorderThickness="1,1,1,0"
								MinHeight="20"
								Padding="3,2,3,2"
								Margin="-1,2,0,0"
								BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static o2k7:UnpinnedTrayElements.BottomTabBorderBrush}, TypeInTargetAssembly={x:Type o2k7:UnpinnedTrayElements}}}"
								Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static o2k7:UnpinnedTrayElements.BottomTabBackgroundBrush}, TypeInTargetAssembly={x:Type o2k7:UnpinnedTrayElements}}}">
								<DockPanel>
