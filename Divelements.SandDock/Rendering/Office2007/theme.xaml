								Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static o2k7:UnpinnedTrayElements.LeftTabBackgroundBrush}, TypeInTargetAssembly={x:Type o2k7:UnpinnedTrayElements}}}">
								<DockPanel>
									<Image
										DockPanel.Dock="Top"
										Width="16"
										VerticalAlignment="Center"
										Source="{Binding Path=Image}" />
									<TextBlock
										Margin="1,2,-1,0"
										TextTrimming="CharacterEllipsis"
										VerticalAlignment="Center"
										Text="{Binding Path=TabText}">
										<FrameworkElement.LayoutTransform>
											<RotateTransform
												Angle="90" />
										</FrameworkElement.LayoutTransform>
									</TextBlock>
								</DockPanel>
							</Border>
						</DataTemplate>
					</Setter.Value>
				</Setter>
