	<ControlTemplate
		TargetType="{x:Type local:WindowGroup}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DocumentWindowGroupTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}">
