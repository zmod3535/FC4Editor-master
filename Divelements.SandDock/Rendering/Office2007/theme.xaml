					ContentSource="SelectedWindow" />
			</Border>
			<Border
				Grid.Row="0"
				BorderThickness="0,0,0,1"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static o2k7:DocumentWindowGroupElements.BorderBrush}, TypeInTargetAssembly={x:Type o2k7:DocumentWindowGroupElements}}}" />
			<DockPanel
				Grid.Row="0">
