			SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Border
