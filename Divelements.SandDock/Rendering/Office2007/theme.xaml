								Padding="1,3,2,3"
								Margin="2,-1,0,0"
								BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static o2k7:UnpinnedTrayElements.RightTabBorderBrush}, TypeInTargetAssembly={x:Type o2k7:UnpinnedTrayElements}}}"
								Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static o2k7:UnpinnedTrayElements.RightTabBackgroundBrush}, TypeInTargetAssembly={x:Type o2k7:UnpinnedTrayElements}}}">
								<DockPanel>
									<Image
