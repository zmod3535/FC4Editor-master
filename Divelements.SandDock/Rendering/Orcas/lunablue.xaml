	</LinearGradientBrush>
	<SolidColorBrush
		Color="Black"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="White"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#ACA899"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}">
		<GradientStop
			Offset="0"
			Color="#ECEBE6" />
		<GradientStop
			Offset="1"
			Color="#FFFFFF" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#716F64"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#FCFCFE"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#91A7B4"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#919B9C"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#ECE9D8"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#8C867B"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#9CB6E7"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#3C5AAA"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#7896D2"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonPressedBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#3C5AAA"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonPressedBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<ControlTemplate xmlns:primitives="clr-namespace:Divelements.SandDock.Primitives"
		TargetType="{x:Type primitives:WindowTab}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowTabTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}">
		<Border
			Name="PART_Border"
			BorderThickness="1,0,1,1"
			CornerRadius="0,0,3,3"
			Margin="0,1,-1,2"
			BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
			Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
			<Grid>
				<Rectangle
					Name="PART_InnerBorder"
					Margin="-1,0,-1,0"
					Height="1"
					VerticalAlignment="Top" />
				<Border
					Name="PART_SelectionDecorator"
					Background="#FFC83C"
					BorderBrush="#E68B2C"
					BorderThickness="1,0,1,1"
					CornerRadius="0,0,3,3"
					Height="3"
					VerticalAlignment="Bottom"
					Margin="-1,0,-1,-1"
					Visibility="Hidden" />
				<DockPanel
					Margin="2,1,3,1">
					<Image
						Name="PART_Image"
						DockPanel.Dock="Left"
						Width="16"
						Height="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Window.Image, RelativeSource={RelativeSource TemplatedParent}}" />
					<TextBlock
						Name="PART_TextBlock"
						Margin="2,0,0,0"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=Window.TabText, RelativeSource={RelativeSource TemplatedParent}}"
						Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				</DockPanel>
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<DataTrigger
				Value="true"
				Binding="{Binding Path=Window.IsSelected, RelativeSource={RelativeSource Self}}">
				<Setter
					TargetName="PART_Border"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_Border"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_InnerBorder"
					Property="Fill"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TextBlock"
					Property="Foreground"
					Value="{Binding Path=Window.TabForeground, RelativeSource={RelativeSource TemplatedParent}}" />
				<Setter
					TargetName="PART_Border"
					Property="Margin"
					Value="0,0,-1,0" />
				<Setter
					TargetName="PART_SelectionDecorator"
					Property="Visibility"
					Value="Visible" />
				<Setter
					TargetName="PART_TextBlock"
					Property="RenderTransform">
					<Setter.Value>
						<TranslateTransform
							Y="-1" />
					</Setter.Value>
				</Setter>
				<Setter
					TargetName="PART_Image"
					Property="RenderTransform">
					<Setter.Value>
						<TranslateTransform
							Y="1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="PART_SelectionDecorator"
					Property="Visibility"
					Value="Visible" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<SolidColorBrush
		Color="#C1D2EE"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.BackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#98B5E2"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.BorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#E1E6E8"
