		<GradientStop
			Offset="0"
			Color="#FDFDFC" />
		<GradientStop
			Offset="1"
			Color="#EEECDD" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#ACA899"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#FDFDFC"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}">
		<GradientStop
			Offset="0"
			Color="#FBFCFD" />
		<GradientStop
			Offset="1"
			Color="#C1D2EE" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#98B5E2"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#FBFCFD"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}">
		<GradientStop
			Offset="0"
			Color="#DCE2E7" />
		<GradientStop
			Offset="1"
			Color="#A2BBE2" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#98B5E2"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#DCE2E7"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#FCFCF9"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#8A867A"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#C5C2B8"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuMarginBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#F1F1F1"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuMarginBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<DataTemplate
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.RightTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}">
		<Grid
			Margin="2,-1,0,0">
			<Border
				Name="TabBorder"
				MinWidth="20"
				Padding="1,3,1,3"
				BorderThickness="1,1,0,1"
				CornerRadius="3,0,0,3"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
				TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
				<Border.Background>
					<LinearGradientBrush
						StartPoint="1,0"
						EndPoint="0,0">
						<GradientStop
							Offset="0"
							Color="#ECEBE6" />
						<GradientStop
							Offset="1"
							Color="#FFFFFF" />
					</LinearGradientBrush>
				</Border.Background>
				<DockPanel>
