						DockPanel.Dock="Top"
						Width="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Image}" />
					<TextBlock
						Margin="0,3,1,0"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=TabText}">
						<FrameworkElement.LayoutTransform>
							<RotateTransform
								Angle="90" />
						</FrameworkElement.LayoutTransform>
					</TextBlock>
				</DockPanel>
			</Border>
			<Border
				Name="PART_SelectionDecorator"
				Background="#FFC83C"
				BorderBrush="#E68B2C"
				BorderThickness="1,1,0,1"
				CornerRadius="3,0,0,3"
				Width="3"
				HorizontalAlignment="Left"
				Visibility="Hidden" />
		</Grid>
		<DataTemplate.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="PART_SelectionDecorator"
					Property="Visibility"
					Value="Visible" />
			</Trigger>
		</DataTemplate.Triggers>
	</DataTemplate>
