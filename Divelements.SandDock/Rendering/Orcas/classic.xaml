<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Divelements.SandDock" xmlns:rendering="clr-namespace:Divelements.SandDock.Rendering" xmlns:orcas="clr-namespace:Divelements.SandDock.Rendering.Orcas">
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="688,0"
		MappingMode="Absolute"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DockSiteBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}">
		<GradientBrush.GradientStops>
			<GradientStop
				Color="#D4D0C8"
				Offset="0" />
			<GradientStop
				Color="#F5F5F4"
				Offset="1" />
		</GradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush
		Color="#808080"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.BorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveCaptionColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveCaptionColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.InactiveCaptionTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ActiveCaptionTextColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#808080"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="Transparent"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlDarkDarkColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="White"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#808080"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="#808080"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="Transparent"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="Transparent"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		Opacity="0.2"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonPressedBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonPressedBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}" />
	<ControlTemplate xmlns:primitives="clr-namespace:Divelements.SandDock.Primitives"
		TargetType="{x:Type primitives:WindowTab}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowTabTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}">
		<Border
			Name="PART_Border"
			BorderThickness="1,0,1,1"
			Margin="0,1,-1,2"
			BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
			Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
			<Grid>
				<DockPanel
					Margin="2,1,3,1">
					<Image
						Name="PART_Image"
						DockPanel.Dock="Left"
						Width="16"
						Height="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Window.Image, RelativeSource={RelativeSource TemplatedParent}}" />
					<TextBlock
						Name="PART_TextBlock"
						Margin="2,0,0,0"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=Window.TabText, RelativeSource={RelativeSource TemplatedParent}}"
						Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				</DockPanel>
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding Path=Window.IsSelected, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="False"
						Binding="{Binding Path=(rendering:Themes.IsHighContrast)}" />
				</MultiDataTrigger.Conditions>
				<Setter
					TargetName="PART_Border"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_Border"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TextBlock"
					Property="Foreground"
					Value="{Binding Path=Window.TabForeground, RelativeSource={RelativeSource TemplatedParent}}" />
				<Setter
					TargetName="PART_Border"
					Property="Margin"
					Value="0,0,-1,0" />
				<Setter
					TargetName="PART_Image"
					Property="RenderTransform">
					<Setter.Value>
						<TranslateTransform
							Y="1" />
					</Setter.Value>
				</Setter>
			</MultiDataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="True"
						Binding="{Binding Path=Window.IsSelected, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="True"
						Binding="{Binding Path=(rendering:Themes.IsHighContrast)}" />
				</MultiDataTrigger.Conditions>
				<Setter
					TargetName="PART_Border"
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					TargetName="PART_Border"
					Value="{DynamicResource SystemColors.ControlTextBrushKey}"
					Property="BorderBrush" />
				<Setter
					TargetName="PART_Border"
					Property="Margin"
					Value="0,0,-1,0" />
				<Setter
					TargetName="PART_Image"
					Property="RenderTransform">
					<Setter.Value>
						<TranslateTransform
							Y="1" />
					</Setter.Value>
				</Setter>
			</MultiDataTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition
						Property="UIElement.IsMouseOver"
						Value="True" />
					<Condition
						Property="rendering:Themes.IsHighContrast"
						Value="False" />
				</MultiTrigger.Conditions>
				<Setter
					TargetName="PART_Border"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
			</MultiTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.BackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlDarkColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.BorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.HighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlDarkColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="0,1"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}">
		<GradientStop
			Offset="0"
			Color="{DynamicResource SystemColors.ControlLightLightColorKey}" />
		<GradientStop
			Offset="1"
			Color="{DynamicResource SystemColors.ControlColorKey}" />
	</LinearGradientBrush>
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlDarkColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlDarkColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="{DynamicResource SystemColors.ControlLightLightColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#F9F8F7"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#666666"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<SolidColorBrush
		Color="#A6A6A6"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuMarginBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}" />
	<LinearGradientBrush
		StartPoint="0,0"
		EndPoint="1,0"
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuMarginBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}">
		<GradientStop
			Offset="0"
			Color="#EEECE9" />
		<GradientStop
			Offset="1"
			Color="#D1CDC7" />
	</LinearGradientBrush>
	<DataTemplate
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.RightTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}">
		<Grid
			Margin="2,-1,0,0">
			<Border
				Name="TabBorder"
				MinWidth="20"
				Padding="1,3,1,3"
				BorderThickness="1,1,0,1"
				Background="#00FFFFFF"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
				TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
				<DockPanel>
					<Image
						DockPanel.Dock="Top"
						Width="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Image}" />
					<TextBlock
						Margin="0,3,1,0"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=TabText}">
						<FrameworkElement.LayoutTransform>
							<RotateTransform
								Angle="90" />
						</FrameworkElement.LayoutTransform>
					</TextBlock>
				</DockPanel>
			</Border>
		</Grid>
		<DataTemplate.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="TabBorder"
					Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
					Property="Background" />
			</Trigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<DataTemplate
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.TopTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}">
		<Grid
			Margin="-1,0,0,2">
			<Border
				Name="TabBorder"
				MinHeight="20"
				Padding="3,1,3,2"
				BorderThickness="1,0,1,1"
				Background="#00FFFFFF"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
				TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
				<DockPanel>
					<Image
						DockPanel.Dock="Left"
						Width="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Image}" />
					<TextBlock
						Margin="3,0,0,2"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=TabText}" />
				</DockPanel>
			</Border>
		</Grid>
		<DataTemplate.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="TabBorder"
					Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
					Property="Background" />
			</Trigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<DataTemplate
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.LeftTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}">
		<Grid
			Margin="0,-1,2,0">
			<Border
				Name="TabBorder"
				MinWidth="20"
				Padding="1,3,2,3"
				BorderThickness="0,1,1,1"
				Background="#00FFFFFF"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
				TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
				<DockPanel>
					<Image
						DockPanel.Dock="Top"
						Width="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Image}" />
					<TextBlock
						Margin="0,3,0,0"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=TabText}">
						<FrameworkElement.LayoutTransform>
							<RotateTransform
								Angle="90" />
						</FrameworkElement.LayoutTransform>
					</TextBlock>
				</DockPanel>
			</Border>
		</Grid>
		<DataTemplate.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="TabBorder"
					Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
					Property="Background" />
			</Trigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<DataTemplate
		x:Key="{ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.BottomTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}">
		<Grid
			Margin="-1,2,0,0">
			<Border
				Name="TabBorder"
				MinHeight="20"
				Padding="3,1,3,2"
				BorderThickness="1,1,1,0"
				Background="#00FFFFFF"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
				TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripNormalTabForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
				<DockPanel>
					<Image
						DockPanel.Dock="Left"
						Width="16"
						VerticalAlignment="Center"
						Source="{Binding Path=Image}" />
					<TextBlock
						Margin="3,0,0,0"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						Text="{Binding Path=TabText}" />
				</DockPanel>
			</Border>
		</Grid>
		<DataTemplate.Triggers>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="TabBorder"
					Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
					Property="Background" />
			</Trigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItem}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Foreground"
			Value="#FF000000" />
		<Style.Triggers>
			<Trigger
				Property="rendering:Themes.IsHighContrast"
				Value="True">
				<Setter
					Property="Background"
					Value="#00FFFFFF" />
				<Setter
					Property="BorderThickness"
					Value="1" />
				<Setter
					Property="BorderBrush"
					Value="#00FFFFFF" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource SystemColors.ControlTextBrushKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItemSelected}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="">
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.HighlightBrushKey}" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource SystemColors.HighlightBrushKey}" />
		<Setter
			Property="Border.CornerRadius"
			Value="3" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource SystemColors.HighlightTextBrushKey}" />
		<Style.Triggers>
			<Trigger
				Property="rendering:Themes.IsHighContrast"
				Value="True">
				<Setter
					Property="Background"
					Value="{DynamicResource SystemColors.HighlightBrushKey}" />
				<Setter
					Property="BorderThickness"
					Value="1" />
				<Setter
					Property="BorderBrush"
					Value="{DynamicResource SystemColors.HighlightTextBrushKey}" />
				<Setter
					Property="Foreground"
					Value="{DynamicResource SystemColors.HighlightTextBrushKey}" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
