<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sd="clr-namespace:Divelements.SandDock" xmlns:sdp="clr-namespace:Divelements.SandDock.Primitives" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" xmlns:rendering="clr-namespace:Divelements.SandDock.Rendering" xmlns:orcas="clr-namespace:Divelements.SandDock.Rendering.Orcas">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="/Divelements.SandDock;component/Resources/ClipArt.xaml" />
		<ResourceDictionary
			Source="Classic.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<SolidColorBrush
		Color="{DynamicResource SystemColors.AppWorkspaceColorKey}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerEmptyBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}" />
	<SolidColorBrush
		Color="Transparent"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerPopulatedBackgroundBrush}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}" />
	<Thickness
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:GeneralElements.DocumentContainerBorderThickness}, TypeInTargetAssembly={x:Type rendering:GeneralElements}}">0</Thickness>
	<Style
		TargetType="{x:Type Button}"
		x:Key="TitleBarButtonStyle">
		<Setter
			Property="Width"
			Value="16" />
		<Setter
			Property="Height"
			Value="15" />
		<Setter
			Property="Focusable"
			Value="False" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type Button}">
					<Border
						Name="PART_Border"
						BorderThickness="1"
						Background="#00FFFFFF">
						<ContentPresenter
							Margin="{TemplateBinding Padding}" />
					</Border>
					<ControlTemplate.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="False"
									Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type sd:WindowGroup}}}" />
								<Condition
									Value="True"
									Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_Border"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
							<Setter
								TargetName="PART_Border"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="True"
									Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type sd:WindowGroup}}}" />
								<Condition
									Value="True"
									Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_Border"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
							<Setter
								TargetName="PART_Border"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition
									Value="True"
									Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type sd:WindowGroup}}}" />
								<Condition
									Value="True"
									Binding="{Binding Path=IsPressed, RelativeSource={RelativeSource Self}}" />
							</MultiDataTrigger.Conditions>
							<Setter
								TargetName="PART_Border"
								Property="Background"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonPressedBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
							<Setter
								TargetName="PART_Border"
								Property="BorderBrush"
								Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonPressedBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ControlTemplate
		TargetType="{x:Type sd:WindowGroup}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DockableWindowGroupTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Border
				Name="PART_Border"
				Grid.RowSpan="2"
				BorderThickness="1"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.BorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
			<Border
				Name="PART_TitleBar"
				Margin="1,1,1,0"
				Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}"
				TextElement.Foreground="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.InactiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}">
				<DockPanel
					Margin="2,1,2,1">
					<Button
						Name="PART_CloseButton"
						Command="{x:Static sd:DockableWindow.CloseCommand}"
						DockPanel.Dock="Right"
						Padding="1"
						Style="{StaticResource TitleBarButtonStyle}"
						CommandTarget="{Binding Path=SelectedWindow, RelativeSource={RelativeSource TemplatedParent}}"
						Foreground="{Binding ElementName=PART_TitleBar, Path=(TextElement.Foreground)}"
						ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.Close, RelativeSource={RelativeSource TemplatedParent}}">
						<TextBlock
							FontFamily="Marlett"
							FontSize="12"
							Text="r" />
					</Button>
					<Button
						Name="PART_PinButton"
						Visibility="Collapsed"
						Command="{x:Static sd:WindowGroup.TogglePinCommand}"
						DockPanel.Dock="Right"
						Padding="1"
						Style="{StaticResource TitleBarButtonStyle}"
						ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.AutoHide, RelativeSource={RelativeSource TemplatedParent}}">
						<Path
							Name="PinButtonPath"
							Data="M0.5,6.5 L6.5,6.5 M1.5,6.5 L1.5,0.5 L4.5,0.5 L4.5,6.5 L5.5,6.5 L5.5,0 M3.5,6.5 L3.5,9.5"
							Margin="2,1,2,0"
							Stroke="{Binding ElementName=PART_TitleBar, Path=(TextElement.Foreground)}" />
					</Button>
					<Button
						Name="PART_OptionsButton"
						Command="{x:Static sd:DockableWindow.WindowOptionsCommand}"
						ClickMode="Press"
						DockPanel.Dock="Right"
						Padding="1"
						Style="{StaticResource TitleBarButtonStyle}"
						Foreground="{Binding ElementName=PART_TitleBar, Path=(TextElement.Foreground)}"
						ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.WindowOptions, RelativeSource={RelativeSource TemplatedParent}}">
						<TextBlock
							FontFamily="Marlett"
							FontSize="12"
							Text="u" />
					</Button>
					<TextBlock
						Name="TitleBarLabel"
						VerticalAlignment="Center"
						TextTrimming="CharacterEllipsis"
						Text="{Binding Path=SelectedWindow.Title, RelativeSource={RelativeSource TemplatedParent}}" />
				</DockPanel>
			</Border>
			<ContentPresenter
				Name="PART_SelectedContentHost"
				Grid.Row="1"
				Margin="0,0,0,0"
				ContentSource="SelectedWindow" />
			<DockPanel
				Name="PART_TabStripContainer"
				Grid.Row="2">
				<Rectangle
					DockPanel.Dock="Top"
					Height="2"
					Fill="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Grid>
					<Border
						BorderThickness="0,1,0,0"
						BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.TabStripBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
					<sdp:WindowList
						Name="PART_WindowList"
						Margin="1,0,1,0"
						ItemsSource="{Binding Path=Windows, RelativeSource={RelativeSource TemplatedParent}}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<sdp:ShrinkingTabPanel
									HorizontalAlignment="Left" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</sdp:WindowList>
				</Grid>
			</DockPanel>
		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger
				Value="False"
				Binding="{Binding Path=SelectedWindow.ShowOptionsButton, RelativeSource={RelativeSource Self}}">
				<Setter
					TargetName="PART_OptionsButton"
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
			<DataTrigger
				Value="False"
				Binding="{Binding Path=SelectedWindow.AllowClose, RelativeSource={RelativeSource Self}}">
				<Setter
					TargetName="PART_CloseButton"
					Property="Visibility"
					Value="Collapsed" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Value="Docked"
						Binding="{Binding Path=SelectedWindow.DockSituation, RelativeSource={RelativeSource Self}}" />
					<Condition
						Value="True"
						Binding="{Binding Path=AllowCollapse, RelativeSource={RelativeSource Self}}" />
				</MultiDataTrigger.Conditions>
				<Setter
					TargetName="PART_PinButton"
					Property="Visibility"
					Value="Visible" />
			</MultiDataTrigger>
			<Trigger
				Property="UIElement.IsKeyboardFocusWithin"
				Value="True">
				<Setter
					TargetName="PART_TitleBar"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveTitleBarBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TitleBar"
					Property="Foreground"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveTitleBarForegroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
			</Trigger>
			<Trigger
				Property="sd:WindowGroup.ShowTitleBar"
				Value="False">
				<Setter
					TargetName="PART_TitleBar"
					Property="Visibility"
					Value="Collapsed" />
				<Setter
					TargetName="PART_SelectedContentHost"
					Property="Margin"
					Value="0" />
			</Trigger>
			<Trigger
				Property="sd:WindowGroup.HasSingleItem"
				Value="True">
				<Setter
					TargetName="PART_TabStripContainer"
					Property="Visibility"
					Value="Collapsed" />
			</Trigger>
			<Trigger
				Property="sd:WindowGroup.ShowTabs"
				Value="False">
				<Setter
					TargetName="PART_TabStripContainer"
					Property="Visibility"
					Value="Collapsed" />
			</Trigger>
			<Trigger
				Property="sd:WindowGroup.Pinned"
				Value="False">
				<Setter
					TargetName="PinButtonPath"
					Property="Data"
					Value="M4.5,0.5 L4.5,6.5 M4.5,1.5 L10.5,1.5 L10.5,4.5 L4.5,4.5 L4.5,5.5 L11,5.5 M4.5,3.5 L0.5,3.5" />
				<Setter
					TargetName="PinButtonPath"
					Property="Margin"
					Value="0,2,0,0" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type sdp:WindowTab}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DocumentWindowTabTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}">
		<sdp:DocumentTabChrome
			Name="PART_TabChrome"
			Margin="-11,3,0,0"
			IsSelected="{Binding Path=Window.IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
			Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}"
			BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}"
			InnerBorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripNormalTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}">
			<DockPanel>
				<Image
					Name="Image"
					Margin="0,0,3,0"
					Width="16"
					Height="16"
					VerticalAlignment="Center"
					Visibility="Collapsed"
					Source="{Binding Path=Window.Image, RelativeSource={RelativeSource TemplatedParent}}" />
				<Grid
					Name="TextGrid"
					Margin="0,-1,4,-1">
					<TextBlock
						Grid.Column="1"
						FontWeight="Bold"
						Visibility="Hidden"
						MinHeight="14"
						Text="{Binding Path=Window.TabText, RelativeSource={RelativeSource TemplatedParent}}" />
					<TextBlock
						Name="Label"
						Grid.Column="1"
						TextTrimming="CharacterEllipsis"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Text="{Binding Path=Window.TabText, RelativeSource={RelativeSource TemplatedParent}}"
						Foreground="{Binding Path=Window.TabForeground, RelativeSource={RelativeSource TemplatedParent}}" />
				</Grid>
			</DockPanel>
		</sdp:DocumentTabChrome>
		<ControlTemplate.Triggers>
			<DataTrigger
				Value="True"
				Binding="{Binding Path=Window.HasLocalImage, RelativeSource={RelativeSource Self}}">
				<Setter
					TargetName="Image"
					Property="Visibility"
					Value="Visible" />
			</DataTrigger>
			<Trigger
				Property="UIElement.IsMouseOver"
				Value="True">
				<Setter
					TargetName="PART_TabChrome"
					Property="sdp:DocumentTabChrome.Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TabChrome"
					Property="sdp:DocumentTabChrome.BorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TabChrome"
					Property="sdp:DocumentTabChrome.InnerBorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripHotTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
			</Trigger>
			<DataTrigger
				Value="true"
				Binding="{Binding Path=Window.IsSelected, RelativeSource={RelativeSource Self}}">
				<Setter
					TargetName="PART_TabChrome"
					Property="Margin"
					Value="-12,1,0,0" />
				<Setter
					TargetName="TextGrid"
					Property="Margin"
					Value="0,0,4,0" />
				<Setter
					TargetName="PART_TabChrome"
					Property="sdp:DocumentTabChrome.Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TabChrome"
					Property="sdp:DocumentTabChrome.BorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
				<Setter
					TargetName="PART_TabChrome"
					Property="sdp:DocumentTabChrome.InnerBorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.TabStripSelectedTabHighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
			</DataTrigger>
			<DataTrigger
				Value="True"
				Binding="{Binding Path=Window.IsLastActiveWindow, RelativeSource={RelativeSource Self}}">
				<Setter
					TargetName="PART_TabChrome"
					Property="FontWeight"
					Value="Bold" />
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="TopLevelMenuItemTemplate">
		<Border
			Name="PART_Border"
			BorderThickness="1">
			<DockPanel>
				<ContentPresenter
					ContentSource="Header"
					Margin="{TemplateBinding Padding}"
					RecognizesAccessKey="True"
					SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
				<Popup
					Name="PART_Popup"
					AllowsTransparency="True"
					Placement="Bottom"
					Focusable="False"
					PopupAnimation="{DynamicResource SystemParameters.MenuPopupAnimationKey}"
					HorizontalOffset="-1"
					VerticalOffset="1"
					IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
					<theme:SystemDropShadowChrome
						Name="PART_Shadow"
						Color="Transparent">
						<Border
							Name="SubMenuBorder"
							BorderThickness="1"
							Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}"
							BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}">
							<ScrollViewer
								CanContentScroll="True"
								Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
								<ItemsPresenter
									Margin="1"
									KeyboardNavigation.TabNavigation="Cycle"
									KeyboardNavigation.DirectionalNavigation="Cycle"
									Grid.IsSharedSizeScope="True" />
							</ScrollViewer>
						</Border>
					</theme:SystemDropShadowChrome>
				</Popup>
			</DockPanel>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger
				SourceName="PART_Popup"
				Property="Popup.HasDropShadow"
				Value="True">
				<Setter
					TargetName="PART_Shadow"
					Property="Margin"
					Value="0,0,5,5" />
				<Setter
					TargetName="PART_Shadow"
					Property="theme:SystemDropShadowChrome.Color"
					Value="#71000000" />
			</Trigger>
			<Trigger
				Property="MenuItem.IsHighlighted"
				Value="True">
				<Setter
					TargetName="PART_Border"
					Property="Background"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
				<Setter
					TargetName="PART_Border"
					Property="BorderBrush"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DockedWindowGroupElements.ActiveButtonHotBorderBrush}, TypeInTargetAssembly={x:Type orcas:DockedWindowGroupElements}}}" />
			</Trigger>
			<Trigger
				Property="rendering:Themes.IsHighContrast"
				Value="True">
				<Setter
					TargetName="SubMenuBorder"
					Value="{DynamicResource SystemColors.MenuBrushKey}"
					Property="Background" />
				<Setter
					TargetName="SubMenuBorder"
					Value="{DynamicResource SystemColors.MenuTextBrushKey}"
					Property="BorderBrush" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type MenuItem}"
		x:Key="MenuItemTemplate">
		<Border>
			<Grid
				SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						MinWidth="27"
						Width="Auto"
						SharedSizeGroup="MenuItemIconColumnGroup" />
					<ColumnDefinition
						Width="6" />
					<ColumnDefinition
						Width="Auto"
						SharedSizeGroup="MenuItemTextColumnGroup" />
					<ColumnDefinition
						Width="13" />
				</Grid.ColumnDefinitions>
				<Border
					Name="MarginBorder"
					BorderThickness="0,0,1,0"
					Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuMarginBackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}"
					BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.MenuMarginBorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}" />
				<Border
					Name="Bd"
					Grid.ColumnSpan="4"
					Margin="0,0,0,1"
					Style="{DynamicResource {ComponentResourceKey ResourceId={x:Static sd:RenderingElement.SelectableItem}, TypeInTargetAssembly={x:Type sd:DockSite}}}" />
				<Image
					Source="{TemplateBinding Icon}"
					Width="16"
					Margin="0,0,1,0" />
				<ContentPresenter
					Grid.Column="2"
					ContentSource="Header"
					Margin="{TemplateBinding Padding}"
					RecognizesAccessKey="False"
					TextElement.Foreground="{Binding ElementName=Bd, Path=(Control.Foreground)}" />
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger
				Property="MenuItem.IsHighlighted"
				Value="True">
				<Setter
					TargetName="Bd"
					Property="Style"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static sd:RenderingElement.SelectableItemSelected}, TypeInTargetAssembly={x:Type sd:DockSite}}}" />
			</Trigger>
			<Trigger
				Property="IsEnabled"
				Value="False">
				<Setter
					Value="{DynamicResource SystemColors.GrayTextBrushKey}"
					Property="Foreground" />
			</Trigger>
			<Trigger
				Property="rendering:Themes.IsHighContrast"
				Value="True">
				<Setter
					TargetName="MarginBorder"
					Value="{DynamicResource SystemColors.MenuBrushKey}"
					Property="Background" />
				<Setter
					TargetName="MarginBorder"
					Value="{DynamicResource SystemColors.MenuTextBrushKey}"
					Property="BorderBrush" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<ControlTemplate
		TargetType="{x:Type sd:WindowGroup}"
		x:Key="{ComponentResourceKey ResourceId={x:Static rendering:DynamicTemplates.DocumentWindowGroupTemplate}, TypeInTargetAssembly={x:Type rendering:DynamicTemplates}}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Border
				BorderThickness="1"
				CornerRadius="3"
				Grid.Row="1"
				Background="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.BackgroundBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}"
				BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.BorderBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}">
				<Border
					BorderThickness="1"
					CornerRadius="2"
					BorderBrush="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:DocumentWindowGroupElements.HighlightBrush}, TypeInTargetAssembly={x:Type orcas:DocumentWindowGroupElements}}}">
					<ContentPresenter
						ContentSource="SelectedWindow"
						Margin="2" />
				</Border>
			</Border>
			<DockPanel
				Grid.Row="0">
				<Button
					Name="PART_CloseButton"
					Command="{x:Static sd:DockableWindow.CloseCommand}"
					DockPanel.Dock="Right"
					Padding="1"
					Margin="0,0,3,0"
					Style="{StaticResource TitleBarButtonStyle}"
					CommandTarget="{Binding Path=SelectedWindow, RelativeSource={RelativeSource TemplatedParent}}"
					ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.Close, RelativeSource={RelativeSource TemplatedParent}}">
					<TextBlock
						FontFamily="Marlett"
						FontSize="12"
						Text="r" />
				</Button>
				<Menu
					Background="#00FFFFFF"
					DockPanel.Dock="Right"
					VerticalAlignment="Center"
					IsMainMenu="False">
					<MenuItem
						DockPanel.Dock="Right"
						HorizontalContentAlignment="Left"
						Margin="0"
						Width="16"
						Height="15"
						Padding="1"
						Template="{StaticResource TopLevelMenuItemTemplate}"
						ItemsSource="{Binding Path=Items, RelativeSource={RelativeSource TemplatedParent}}"
						ToolTip="{Binding Path=SelectedWindow.DockSite.LanguageStrings.ActiveFiles, RelativeSource={RelativeSource TemplatedParent}}">
						<HeaderedItemsControl.Header>
							<TextBlock
								FontFamily="Marlett"
								Text="u"
								FontSize="12" />
						</HeaderedItemsControl.Header>
						<ItemsControl.ItemContainerStyle>
							<Style
								TargetType="{x:Type MenuItem}">
								<Setter
									Property="Header"
									Value="{Binding Path=TabText}" />
								<Setter
									Property="MenuItem.Command"
									Value="{x:Static sd:DockableWindow.OpenCommand}" />
								<Setter
									Property="MenuItem.CommandTarget"
									Value="{Binding}" />
								<Setter
									Property="Template"
									Value="{StaticResource MenuItemTemplate}" />
								<Setter
									Property="Padding"
									Value="2,4,2,5" />
								<Setter
									Property="MenuItem.Icon"
									Value="{Binding Path=Image}" />
							</Style>
						</ItemsControl.ItemContainerStyle>
					</MenuItem>
				</Menu>
				<ScrollViewer
					Name="Scroller"
					VerticalScrollBarVisibility="Hidden"
					HorizontalScrollBarVisibility="Hidden"
					Focusable="False"
					Margin="0,0,0,-1">
					<sdp:WindowList
						Name="PART_WindowList"
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						ItemsSource="{Binding Path=Windows, RelativeSource={RelativeSource TemplatedParent}}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel
									Margin="15,0,0,0"
									Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</sdp:WindowList>
				</ScrollViewer>
			</DockPanel>
		</Grid>
	</ControlTemplate>
	<Style
		TargetType="{x:Type sdp:UnpinnedTabStrip}"
		x:Key="{x:Type sdp:UnpinnedTabStrip}">
		<Setter
			Property="Dock"
			Value="{Binding Path=(sd:DockSite.Dock), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type sdp:UnpinnedTray}}}" />
		<Setter
			Property="ItemsSource"
			Value="{Binding Path=WindowGroup.Items, RelativeSource={RelativeSource Self}}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type sdp:UnpinnedTabStrip}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<ItemsPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger
				Property="Dock"
				Value="Top">
				<Setter
					Property="Margin"
					Value="4,0,4,0" />
				<Setter
					Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel
								Orientation="Horizontal"
								HorizontalAlignment="Left" />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="ItemTemplate"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.TopTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}}" />
			</Trigger>
			<Trigger
				Property="Dock"
				Value="Right">
				<Setter
					Property="Margin"
					Value="0,4,0,4" />
				<Setter
					Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel
								Orientation="Vertical"
								VerticalAlignment="Top" />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="ItemTemplate"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.RightTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}}" />
			</Trigger>
			<Trigger
				Property="Dock"
				Value="Bottom">
				<Setter
					Property="Margin"
					Value="4,0,4,0" />
				<Setter
					Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel
								Orientation="Horizontal"
								HorizontalAlignment="Left" />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="ItemTemplate"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.BottomTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}}" />
			</Trigger>
			<Trigger
				Property="Dock"
				Value="Left">
				<Setter
					Property="Margin"
					Value="0,4,0,4" />
				<Setter
					Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel
								Orientation="Vertical"
								VerticalAlignment="Top" />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
				<Setter
					Property="ItemTemplate"
					Value="{DynamicResource {ComponentResourceKey ResourceId={x:Static orcas:CollapsedWindowGroupElements.LeftTabTemplate}, TypeInTargetAssembly={x:Type orcas:CollapsedWindowGroupElements}}}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style
		TargetType="{x:Type sdp:PopupContainerSplitter}"
		x:Key="{x:Type sdp:PopupContainerSplitter}">
		<Setter
			Property="Background"
			Value="#00FFFFFF" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type sdp:PopupContainerSplitter}">
					<Border
						Name="OuterBorder"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Background="{TemplateBinding Background}">
						<Border
							Name="InnerBorder" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger
							Property="Dock"
							Value="Left">
							<Setter
								TargetName="InnerBorder"
								Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="InnerBorder"
								Property="BorderThickness"
								Value="1,0,0,0" />
							<Setter
								TargetName="OuterBorder"
								Property="BorderThickness"
								Value="1,0,0,0" />
							<Setter
								Property="Width"
								Value="4" />
						</Trigger>
						<Trigger
							Property="Dock"
							Value="Top">
							<Setter
								TargetName="InnerBorder"
								Value="{DynamicResource SystemColors.ControlLightLightBrushKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="InnerBorder"
								Property="BorderThickness"
								Value="0,1,0,0" />
							<Setter
								TargetName="OuterBorder"
								Property="BorderThickness"
								Value="0,1,0,0" />
							<Setter
								Property="Height"
								Value="4" />
						</Trigger>
						<Trigger
							Property="Dock"
							Value="Right">
							<Setter
								TargetName="InnerBorder"
								Value="{DynamicResource SystemColors.ControlDarkBrushKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="OuterBorder"
								Value="{DynamicResource SystemColors.ControlDarkDarkBrushKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="InnerBorder"
								Property="BorderThickness"
								Value="0,0,1,0" />
							<Setter
								TargetName="OuterBorder"
								Property="BorderThickness"
								Value="0,0,1,0" />
							<Setter
								Property="Width"
								Value="4" />
						</Trigger>
						<Trigger
							Property="Dock"
							Value="Bottom">
							<Setter
								TargetName="InnerBorder"
								Value="{DynamicResource SystemColors.ControlDarkBrushKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="OuterBorder"
								Value="{DynamicResource SystemColors.ControlDarkDarkBrushKey}"
								Property="BorderBrush" />
							<Setter
								TargetName="InnerBorder"
								Property="BorderThickness"
								Value="0,0,0,1" />
							<Setter
								TargetName="OuterBorder"
								Property="BorderThickness"
								Value="0,0,0,1" />
							<Setter
								Property="Height"
								Value="4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
