<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Divelements.SandDock" xmlns:localprimitives="clr-namespace:Divelements.SandDock.Primitives" xmlns:rendering="clr-namespace:Divelements.SandDock.Rendering">
	<Style
		x:Key="TitleBarBackground">
		<Setter
			Property="BorderThickness"
			Value="1,1,1,0" />
	</Style>
	<Style
		BasedOn="{StaticResource TitleBarBackground}"
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.InactiveDockedTitleBar}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="BorderBrush"
			Value="#808080" />
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#E2E6EF" />
					<GradientStop
						Offset="0.1"
						Color="#BFCDDB" />
					<GradientStop
						Offset="1"
						Color="#D7E4F2" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Foreground"
			Value="#555555" />
	</Style>
	<Style
		BasedOn="{StaticResource TitleBarBackground}"
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.ActiveDockedTitleBar}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="BorderBrush"
			Value="#343434" />
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FFFFFF" />
					<GradientStop
						Offset="0.1"
						Color="#98B4D0" />
					<GradientStop
						Offset="1"
						Color="#B9D1EA" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Foreground"
			Value="#FF000000" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.TitleBarButton}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Border.CornerRadius"
			Value="2" />
		<Setter
			Property="Padding"
			Value="4,0,4,0" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.InactiveTitleBarButtonHot}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="">
		<Setter
			Property="BorderBrush"
			Value="#515E6C" />
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#AAD5F3" />
					<GradientStop
						Offset="0.5"
						Color="#7DBEE9" />
					<GradientStop
						Offset="0.5"
						Color="#2D73A3" />
					<GradientStop
						Offset="1"
						Color="#24C6EB" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.ActiveTitleBarButtonHot}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="" />
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.ActiveTitleBarButtonPressed}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="">
		<Setter
			Property="BorderBrush"
			Value="#515E6C" />
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#7F9AAC" />
					<GradientStop
						Offset="0.5"
						Color="#5A748A" />
					<GradientStop
						Offset="0.5"
						Color="#203B52" />
					<GradientStop
						Offset="1"
						Color="#27C9C8" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DocumentGroupTabStrip}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="Background"
			Value="#E4E2D5" />
		<Setter
			Property="BorderBrush"
			Value="#7F9DB9" />
		<Setter
			Property="BorderThickness"
			Value="0,0,0,1" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DocumentTab}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#FEFDFD" />
					<GradientStop
						Offset="1"
						Color="#F1EFE2" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter
			Property="BorderBrush"
			Value="#ACA899" />
		<Setter
			Property="Foreground"
			Value="#FF000000" />
		<Setter
			Property="Margin"
			Value="-12,2,0,0" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DocumentSelectedTab}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="">
		<Setter
			Property="Panel.ZIndex"
			Value="1" />
		<Setter
			Property="Background"
			Value="{DynamicResource SystemColors.WindowBrushKey}" />
		<Setter
			Property="BorderBrush"
			Value="#7F9DB9" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.DocumentActiveTab}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="">
		<Setter
			Property="FontWeight"
			Value="Bold" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItem}, TypeInTargetAssembly={x:Type local:DockSite}}">
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="BorderBrush"
			Value="#00FFFFFF" />
		<Setter
			Property="Border.CornerRadius"
			Value="3" />
	</Style>
	<Style
		x:Key="{ComponentResourceKey ResourceId={x:Static local:RenderingElement.SelectableItemSelected}, TypeInTargetAssembly={x:Type local:DockSite}}"
		BasedOn="">
		<Setter
			Property="BorderBrush"
			Value="#B7E7FC" />
		<Setter
			Property="Background">
			<Setter.Value>
				<LinearGradientBrush
					StartPoint="0,0"
					EndPoint="0,1">
					<GradientStop
						Offset="0"
						Color="#E9F7FE" />
					<GradientStop
						Offset="1"
						Color="#C5E9FB" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
